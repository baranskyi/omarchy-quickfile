VERSION = "0.16.0"
DEFAULT_LIMIT = 2000
COMMAND_TIMEOUT = 3
# `git status` is the only command on the navigation path that can scale with
# repository size rather than with the directory being shown.
GIT_STATUS_TIMEOUT = 2
GIT_SLOW_SCOPE_TTL = 120.0
DEFAULT_CONTENT_FILE_LIMIT = 1024 * 1024
DEFAULT_CONTENT_BYTE_LIMIT = 8 * 1024 * 1024
CONTENT_LINE_LIMIT = 4096
CONTENT_SNIPPET_LIMIT = 160
METADATA_SIZE_LIMIT = 8 * 1024 * 1024
NOTE_LENGTH_LIMIT = 16384
FAVORITES_LIMIT = 200
COLOR_KEYS = {"red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown"}
KNOWLEDGE_LIMIT = 128
WATCH_PATH_LIMIT = 4096
OPERATION_ENTRY_LIMIT = 250000
# Measuring only reads: it journals nothing and holds no per-entry state, so
# the copy scanner's ceiling — sized for what undo has to record — would stop
# it far short of an ordinary home directory. It stays bounded, just at a
# height a real tree fits under, and remains cancellable throughout.
MEASURE_ENTRY_LIMIT = 20000000
# How much the walk may hold, as opposed to how far it may count. It runs in
# the long-lived helper beside the panel, so a single directory of millions of
# entries must never be materialized, and neither the queue of directories
# still to visit nor the hard-link identities may grow with the tree. Past
# either ceiling the walk keeps counting and reports `truncated`.
MEASURE_PENDING_LIMIT = 50000
MEASURE_IDENTITY_LIMIT = 200000
OPERATION_DEPTH_LIMIT = 128
OPERATION_HISTORY_LIMIT = 50
OPERATION_HISTORY_SIZE_LIMIT = 2 * 1024 * 1024
OPERATION_JOURNAL_BUDGET = 1024 * 1024
COPY_CHUNK_SIZE = 1024 * 1024
QUICK_NAV_LIMIT = 200
