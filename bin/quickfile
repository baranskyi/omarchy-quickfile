#!/usr/bin/env python3
"""Small, dependency-free backend for the Omarchy Quickfile shell plugin.

The QML process only receives bounded JSON. Paths are also represented by
URL-safe base64 tokens so every Linux filename remains addressable even when
it is not valid UTF-8.
"""

from __future__ import annotations

import argparse
import base64
import ctypes
import datetime as dt
import errno
import grp
import hashlib
