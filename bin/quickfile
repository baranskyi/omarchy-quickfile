    "codex": ("codex", "Codex"),
    "claude": ("claude", "Claude"),
    "gemini": ("gemini", "Gemini"),
    "copilot": ("copilot", "GitHub Copilot"),
    "github-copilot": ("copilot", "GitHub Copilot"),
    "github-copilot-cli": ("copilot", "GitHub Copilot"),
    "cursor-agent": ("cursor", "Cursor Agent"),
    "windsurf-agent": ("windsurf", "Windsurf Agent"),
}


class QuickfileError(Exception):
    def __init__(self, message: str, code: str = "quickfile-error") -> None:
        super().__init__(message)
        self.code = code


class OperationCancelled(QuickfileError):
    def __init__(self) -> None:
        super().__init__("Operation cancelled", "cancelled")


class OperationConflict(QuickfileError):
    def __init__(self, conflicts: list[dict[str, Any]]) -> None:
        super().__init__(
            "One or more items already exist at the destination",
            "operation-conflict",
        )
        self.conflicts = conflicts


def json_print(value: dict[str, Any]) -> None:
    print(json.dumps(value, ensure_ascii=True, separators=(",", ":")), flush=True)


def display_text(value: str) -> str:
    """Replace surrogateescaped bytes while preserving normal Unicode."""
    return value.encode("utf-8", "replace").decode("utf-8")


def encode_path(path: str | bytes) -> str:
    raw = path if isinstance(path, bytes) else os.fsencode(path)
    return base64.urlsafe_b64encode(raw).decode("ascii").rstrip("=")


def decode_path(token: str) -> str:
    try:
        padding = "=" * (-len(token) % 4)
        raw = base64.urlsafe_b64decode((token + padding).encode("ascii"))
        return os.fsdecode(raw)
    except (ValueError, UnicodeEncodeError) as exc:
        raise QuickfileError("Invalid path token", "invalid-path-token") from exc


def normalized_path(path: str) -> str:
    return os.path.abspath(os.path.expanduser(path))


def uri_for(path: str) -> str:
    if any(0xDC80 <= ord(char) <= 0xDCFF for char in path):
        return ""
    try:
        return Path(path).as_uri()
    except ValueError:
        return ""


def metadata_file() -> Path:
    override = os.environ.get("QUICKFILE_METADATA_FILE", "").strip()
    if override:
        return Path(override).expanduser()
    data_home = os.environ.get("XDG_DATA_HOME", "").strip()
    base = Path(data_home).expanduser() if data_home else Path.home() / ".local" / "share"
    return base / "omarchy" / "quickfile" / "metadata.json"


def settings_file() -> Path:
    override = os.environ.get("QUICKFILE_SETTINGS_FILE", "").strip()
    if override:
        return Path(override).expanduser()
    config_home = os.environ.get("XDG_CONFIG_HOME", "").strip()
    base = Path(config_home).expanduser() if config_home else Path.home() / ".config"
    return base / "omarchy" / "quickfile" / "settings.json"


def quickfile_home() -> str:
    override = os.environ.get("QUICKFILE_HOME", "").strip()
    return normalized_path(override) if override else normalized_path(str(Path.home()))


def quick_nav_file() -> Path:
    override = os.environ.get("QUICKFILE_NAV_FILE", "").strip()
    if override:
        return Path(override).expanduser()
    state_home = os.environ.get("XDG_STATE_HOME", "").strip()
    base = Path(state_home).expanduser() if state_home else Path.home() / ".local" / "state"
    return base / "omarchy" / "quickfile" / "recent-locations.json"


def load_quick_nav_recents() -> list[dict[str, Any]]:
    path = quick_nav_file()
    try:
        if not path.exists():
            return []
        if path.stat().st_size > QUICK_NAV_SIZE_LIMIT:
            raise QuickfileError("Recent locations are too large", "quick-nav-too-large")
        payload = json.loads(path.read_text(encoding="utf-8"))
    except QuickfileError:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise QuickfileError(
            f"Could not read recent locations: {exc}", "quick-nav-read-failed"
        ) from exc
    if not isinstance(payload, dict) or not isinstance(payload.get("locations"), list):
        raise QuickfileError("Recent locations have an invalid format", "quick-nav-invalid")
    rows: list[dict[str, Any]] = []
    for item in payload["locations"][:QUICK_NAV_LIMIT]:
        if not isinstance(item, dict) or not isinstance(item.get("token"), str):
            continue
        try:
            location = normalized_path(decode_path(item["token"]))
        except QuickfileError:
            continue
        rows.append({"path": location, "visitedAt": str(item.get("visitedAt", ""))})
    return rows


def save_quick_nav_recents(rows: list[dict[str, Any]]) -> None:
    path = quick_nav_file()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    locations = [
        {"token": encode_path(str(row["path"])), "visitedAt": str(row.get("visitedAt", ""))}
        for row in rows[:QUICK_NAV_LIMIT]
    ]
    payload = json.dumps(
        {"version": 1, "locations": locations},
        ensure_ascii=True,
        separators=(",", ":"),
    ) + "\n"
    if len(payload.encode("utf-8")) > QUICK_NAV_SIZE_LIMIT:
        raise QuickfileError("Recent locations are too large", "quick-nav-too-large")
    descriptor, temporary = tempfile.mkstemp(prefix=".recent-locations.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except OSError as exc:
        raise QuickfileError(
            f"Could not save recent locations: {exc}", "quick-nav-write-failed"
        ) from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def record_quick_nav_location(path: str) -> list[dict[str, Any]]:
    location = normalized_path(path)
    if not os.path.isdir(location):
        raise QuickfileError("Only folders can be added to recent locations", "not-a-directory")
    rows = [row for row in load_quick_nav_recents() if row["path"] != location]
    rows.insert(0, {"path": location, "visitedAt": iso_time(time.time())})
    rows = rows[:QUICK_NAV_LIMIT]
    save_quick_nav_recents(rows)
    return rows


def xdg_user_directories() -> list[tuple[str, str]]:
    labels = {
        "DESKTOP": "Desktop", "DOCUMENTS": "Documents", "DOWNLOAD": "Downloads",
        "MUSIC": "Music", "PICTURES": "Pictures", "PUBLICSHARE": "Public",
        "TEMPLATES": "Templates", "VIDEOS": "Videos",
    }
    values: dict[str, str] = {}
    config_home = os.environ.get("XDG_CONFIG_HOME", "").strip()
    config = (Path(config_home).expanduser() if config_home else Path.home() / ".config") / "user-dirs.dirs"
    try:
        if config.exists() and config.stat().st_size <= 65536:
            for line in config.read_text(encoding="utf-8").splitlines():
                match = re.fullmatch(r'XDG_([A-Z]+)_DIR="([^"\x00]*)"', line.strip())
                if not match or match.group(1) not in labels:
                    continue
                raw = match.group(2)
                home = str(Path.home())
                if raw == "$HOME":
                    raw = home
                elif raw.startswith("$HOME/"):
                    raw = os.path.join(home, raw[6:])
                elif not os.path.isabs(raw):
                    continue
                values[match.group(1)] = normalized_path(raw)
    except (OSError, UnicodeError):
        pass
    return [(labels[key], path) for key, path in values.items() if os.path.isdir(path)]


def git_navigation_rows(seeds: list[str], deadline: float) -> list[tuple[str, str]]:
    roots: list[str] = []
    worktrees: list[str] = []
    for seed in seeds[:12]:
        if time.monotonic() >= deadline or not os.path.isdir(seed):
            break
        code, output, _ = run_bounded(
            ["git", "-C", seed, "rev-parse", "--show-toplevel"], timeout=1, limit=8192
        )
        if code != 0 or not output.strip():
            continue
        root = normalized_path(output.splitlines()[0])
        if root not in roots:
            roots.append(root)
        if time.monotonic() >= deadline:
            break
        code, output, _ = run_bounded(
            ["git", "-C", root, "worktree", "list", "--porcelain"],
            timeout=1,
            limit=QUICK_NAV_COMMAND_LIMIT,
        )
        if code == 0:
            for line in output.splitlines():
                if not line.startswith("worktree "):
                    continue
                candidate = normalized_path(line[9:])
                if os.path.isdir(candidate) and candidate not in worktrees:
                    worktrees.append(candidate)
                    if len(worktrees) >= QUICK_NAV_LIMIT:
                        break
    rows = [("git", path) for path in roots]
    rows.extend(("worktree", path) for path in worktrees if path not in roots)
    return rows[:QUICK_NAV_LIMIT]


def zoxide_navigation_paths(deadline: float) -> list[str]:
    executable = shutil.which("zoxide")
    if not executable or time.monotonic() >= deadline:
        return []
    code, output, _ = run_bounded(
        [executable, "query", "--list"], timeout=2, limit=QUICK_NAV_COMMAND_LIMIT
    )
    if code != 0:
        return []
    paths: list[str] = []
    for line in output.splitlines():
        if len(paths) >= QUICK_NAV_LIMIT:
            break
        candidate = normalized_path(line)
        if line and os.path.isdir(candidate) and candidate not in paths:
            paths.append(candidate)
    return paths


def quick_nav_command(args: argparse.Namespace) -> dict[str, Any]:
    limit = min(QUICK_NAV_LIMIT, max(1, int(getattr(args, "limit", QUICK_NAV_LIMIT))))
    current = path_from_args(args, required=False)
    recents = (
        record_quick_nav_location(current)
        if getattr(args, "record", False)
        else load_quick_nav_recents()
    )
    home = normalized_path(str(Path.home()))
    xdg = xdg_user_directories()
    seeds = [current, *[row["path"] for row in recents], *[path for _, path in xdg], home]
    deadline = time.monotonic() + 3.0
    git_rows = git_navigation_rows(seeds, deadline)
    zoxide = [] if getattr(args, "no_zoxide", False) else zoxide_navigation_paths(deadline)

    candidates: list[tuple[str, str, str]] = [("Home", home, "home")]
    candidates.extend((label, path, "xdg") for label, path in xdg if path != home)
    candidates.extend((os.path.basename(path) or path, path, kind) for kind, path in git_rows)
    candidates.extend((os.path.basename(row["path"]) or row["path"], row["path"], "recent")
                      for row in recents)
    candidates.extend((os.path.basename(path) or path, path, "zoxide") for path in zoxide)
    entries: list[dict[str, Any]] = []
    seen: set[str] = set()
    for label, path, source in candidates:
        normalized = normalized_path(path)
        if normalized in seen or not os.path.isdir(normalized):
            continue
        seen.add(normalized)
        entries.append({
            "name": display_text(label), "path": display_text(normalized),
            "token": encode_path(normalized), "kind": source, "source": source,
        })
        if len(entries) >= limit:
            break
    return {
        "ok": True, "entries": entries, "count": len(entries),
        "truncated": len(seen) >= limit and len(candidates) > len(entries),
    }


class WatchPaths:
    """Bounded dependencies of a response, including not-yet-existing files."""

    def __init__(self) -> None:
        self.directories: set[str] = set()
        self.files: set[str] = set()
        self.truncated = False
        self.add_file(str(metadata_file()))

    def add(self, path: str, *, directory: bool = False) -> None:
        target = self.directories if directory else self.files
        for absolute in (normalized_path(path), os.path.realpath(normalized_path(path))):
            if absolute in target:
                continue
            if len(self.directories) + len(self.files) >= WATCH_PATH_LIMIT:
                self.truncated = True
                return
            target.add(absolute)

    def add_file(self, path: str) -> None:
        self.add(path)

    def add_directory(self, path: str) -> None:
        self.add(path, directory=True)

    def add_git(self, git: dict[str, Any]) -> None:
        root_token = git.get("rootToken")
        if not root_token:
            return
        root = decode_path(root_token)
        # rev-parse handles both ordinary repositories and linked worktrees.
        code, output, _ = run_bounded([
            "git", "-C", root, "rev-parse", "--path-format=absolute",
            "--git-path", "HEAD", "--git-path", "index",
            "--git-path", "packed-refs", "--git-path", "refs/heads",
        ])
        if code:
            return
        paths = output.splitlines()
        for path in paths[:3]:
            self.add_file(path)
        if len(paths) > 3:
            self.add_directory(paths[3])
            branch = str(git.get("branch", ""))
            if branch:
                self.add_file(os.path.join(paths[3], branch))

    def payload(self) -> dict[str, Any]:
        return {
            "directories": sorted(encode_path(path) for path in self.directories),
            "files": sorted(encode_path(path) for path in self.files),
            "truncated": self.truncated,
        }


def empty_metadata_store() -> dict[str, Any]:
    return {"version": 2, "items": {}}


def load_metadata_store() -> dict[str, Any]:
    path = metadata_file()
    try:
        if not path.exists():
            return empty_metadata_store()
        if path.stat().st_size > METADATA_SIZE_LIMIT:
            raise QuickfileError("Quickfile metadata is too large", "metadata-too-large")
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except QuickfileError:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise QuickfileError(f"Could not read Quickfile metadata: {exc}", "metadata-read-failed") from exc
    if not isinstance(parsed, dict) or not isinstance(parsed.get("items"), dict):
        raise QuickfileError("Quickfile metadata has an invalid format", "metadata-invalid")
    parsed["version"] = 2
    return parsed


def save_metadata_store(store: dict[str, Any]) -> None:
    path = metadata_file()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    payload = json.dumps(store, ensure_ascii=True, separators=(",", ":")) + "\n"
    if len(payload.encode("utf-8")) > METADATA_SIZE_LIMIT:
        raise QuickfileError("Quickfile metadata is too large", "metadata-too-large")
    descriptor, temporary = tempfile.mkstemp(prefix=".metadata.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except OSError as exc:
        raise QuickfileError(f"Could not save Quickfile metadata: {exc}", "metadata-write-failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def default_module_layout() -> list[dict[str, Any]]:
    return [
        {
            "id": module_id,
            "pinned": module_id in {"sessions", "knowledge"},
            "collapsed": False,
        }
        for module_id in MODULE_ORDER
    ]


def normalize_module_layout(value: Any) -> list[dict[str, Any]]:
    if not isinstance(value, list):
        raise QuickfileError("Module layout must be a list", "settings-invalid-layout")
    rows: list[dict[str, Any]] = []
    seen: set[str] = set()
    for raw in value:
        if not isinstance(raw, dict):
            raise QuickfileError("Module layout entries must be objects", "settings-invalid-layout")
        module_id = raw.get("id")
        if not isinstance(module_id, str) or module_id not in MODULE_KEYS:
            raise QuickfileError("Module layout contains an unknown module", "settings-invalid-layout")
        if module_id in seen:
            raise QuickfileError("Module layout contains a duplicate module", "settings-invalid-layout")
        pinned = raw.get("pinned", False)
        collapsed = raw.get("collapsed", False)
        if not isinstance(pinned, bool) or not isinstance(collapsed, bool):
            raise QuickfileError("Module flags must be true or false", "settings-invalid-layout")
        rows.append({"id": module_id, "pinned": pinned, "collapsed": collapsed})
        seen.add(module_id)
    defaults = {row["id"]: row for row in default_module_layout()}
    rows.extend(defaults[module_id] for module_id in MODULE_ORDER if module_id not in seen)
    return rows


def default_settings_store() -> dict[str, Any]:
    return {
        "version": 2,
        "activeSessionsEnabled": False,
        "inspectorTab": "properties",
        "modules": default_module_layout(),
    }


def load_settings_store() -> dict[str, Any]:
    path = settings_file()
    try:
        if not path.exists():
            return default_settings_store()
        if path.stat().st_size > SETTINGS_SIZE_LIMIT:
            raise QuickfileError("QuickFile settings are too large", "settings-too-large")
        parsed = json.loads(path.read_text(encoding="utf-8"))
    except QuickfileError:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise QuickfileError(f"Could not read QuickFile settings: {exc}", "settings-read-failed") from exc
    if not isinstance(parsed, dict):
        raise QuickfileError("QuickFile settings have an invalid format", "settings-invalid")
    active_sessions = parsed.get("activeSessionsEnabled", False)
    if not isinstance(active_sessions, bool):
        raise QuickfileError("Active-session preference must be true or false", "settings-invalid")
    inspector_tab = parsed.get("inspectorTab", "properties")
    if not isinstance(inspector_tab, str) or inspector_tab not in INSPECTOR_TAB_KEYS:
        raise QuickfileError("Inspector tab preference is invalid", "settings-invalid")
    return {
        "version": 2,
        "activeSessionsEnabled": active_sessions,
        "inspectorTab": inspector_tab,
        "modules": normalize_module_layout(parsed.get("modules", default_module_layout())),
    }


def save_settings_store(store: dict[str, Any]) -> None:
    path = settings_file()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    payload = json.dumps(store, ensure_ascii=True, separators=(",", ":")) + "\n"
    if len(payload.encode("utf-8")) > SETTINGS_SIZE_LIMIT:
        raise QuickfileError("QuickFile settings are too large", "settings-too-large")
    descriptor, temporary = tempfile.mkstemp(prefix=".settings.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except OSError as exc:
        raise QuickfileError(f"Could not save QuickFile settings: {exc}", "settings-write-failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def settings_command(args: argparse.Namespace) -> dict[str, Any]:
    store = load_settings_store()
    changed = False
    active_sessions = getattr(args, "active_sessions", None)
    if active_sessions is not None:
        enabled = active_sessions == "true"
        changed = changed or store["activeSessionsEnabled"] != enabled
        store["activeSessionsEnabled"] = enabled
    inspector_tab = getattr(args, "inspector_tab", None)
    if inspector_tab is not None:
        if inspector_tab not in INSPECTOR_TAB_KEYS:
            raise QuickfileError("Inspector tab preference is invalid", "settings-invalid")
        changed = changed or store["inspectorTab"] != inspector_tab
        store["inspectorTab"] = inspector_tab
    module_layout_json = getattr(args, "module_layout_json", None)
    if module_layout_json is not None:
        try:
            raw_layout = json.loads(module_layout_json)
        except json.JSONDecodeError as exc:
            raise QuickfileError("Module layout is not valid JSON", "settings-invalid-layout") from exc
        layout = normalize_module_layout(raw_layout)
        changed = changed or store["modules"] != layout
        store["modules"] = layout
    if changed:
        save_settings_store(store)
    return {"ok": True, "settings": store, "changed": changed}


def item_metadata(store: dict[str, Any], token: str) -> dict[str, Any]:
    value = store.get("items", {}).get(token, {})
    return value if isinstance(value, dict) else {}


def enrich_row(row: dict[str, Any], store: dict[str, Any]) -> dict[str, Any]:
    metadata = item_metadata(store, str(row.get("token", "")))
    row["color"] = str(metadata.get("color", ""))
    row["note"] = str(metadata.get("note", ""))
    row["starred"] = metadata.get("starred") is True
    row["registeredKnowledge"] = metadata.get("knowledge") is True
    raw_agents = metadata.get("agents", [])
    row["knowledgeAgents"] = [
        agent for agent in raw_agents
        if isinstance(agent, str) and agent in KNOWLEDGE_AGENT_KEYS
    ] if isinstance(raw_agents, list) else []
    return row


def enrich_rows(rows: list[dict[str, Any]], store: dict[str, Any]) -> None:
    for row in rows:
        enrich_row(row, store)


def favorite_rows(store: dict[str, Any]) -> list[dict[str, Any]]:
    rows: list[tuple[str, dict[str, Any]]] = []
    empty_git = {"root": "", "branch": "", "statuses": {}}
    for token, raw in store.get("items", {}).items():
        if len(rows) >= FAVORITES_LIMIT or not isinstance(raw, dict) or raw.get("starred") is not True:
            continue
        try:
            path = normalized_path(decode_path(str(token)))
        except QuickfileError:
            continue
        if not os.path.lexists(path):
            continue
        try:
            row = entry_row(path, 0, empty_git, set())
        except QuickfileError:
            continue
        enrich_row(row, store)
        row["parentPath"] = display_text(os.path.dirname(path) or os.sep)
        rows.append((str(raw.get("starredAt", raw.get("updatedAt", ""))), row))
    rows.sort(key=lambda pair: (pair[0], pair[1]["name"].casefold()), reverse=True)
    return [row for _, row in rows]


def path_from_args(args: argparse.Namespace, *, required: bool = True) -> str:
    token = getattr(args, "path_token", None)
    value = getattr(args, "path", None)
    if token:
        return normalized_path(decode_path(token))
    if value:
        return normalized_path(value)
    if required:
        raise QuickfileError("A path or path token is required", "missing-path")
    return normalized_path(os.path.expanduser("~"))


def iso_time(timestamp: float | int | None) -> str:
    if timestamp is None:
        return ""
    try:
        return dt.datetime.fromtimestamp(float(timestamp), dt.timezone.utc).astimezone().isoformat(timespec="seconds")
    except (ValueError, OSError, OverflowError):
        return ""


def run_bounded(argv: list[str], *, timeout: int = COMMAND_TIMEOUT, limit: int = 131072) -> tuple[int, str, str]:
    try:
        process = subprocess.Popen(
            argv,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
    except OSError as exc:
        return 127, "", str(exc)
    output = bytearray()
    errors = bytearray()
    selector = selectors.DefaultSelector()
    assert process.stdout is not None and process.stderr is not None
    selector.register(process.stdout, selectors.EVENT_READ, (output, max(0, limit)))
    selector.register(process.stderr, selectors.EVENT_READ, (errors, 8192))
    deadline = time.monotonic() + timeout
    timed_out = False
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                process.kill()
                remaining = 0.2
            events = selector.select(min(max(remaining, 0.01), 0.2))
            for key, _mask in events:
                chunk = os.read(key.fileobj.fileno(), 8192)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                buffer, bound = key.data
                if len(buffer) < bound:
                    buffer.extend(chunk[:bound - len(buffer)])
            if timed_out and process.poll() is not None and not events:
                # The next selector iteration drains any final pipe bytes/EOF.
                continue
        return_code = process.wait()
    finally:
        selector.close()
        if process.poll() is None:
            process.kill()
            process.wait()
        process.stdout.close()
        process.stderr.close()
    if timed_out:
        return 127, output.decode("utf-8", "replace"), f"Command timed out after {timeout}s"
    return return_code, output.decode("utf-8", "replace"), errors.decode("utf-8", "replace")


def human_size(size: int) -> str:
    amount = float(max(0, size))
    units = ("B", "KiB", "MiB", "GiB", "TiB", "PiB")
    index = 0
    while amount >= 1024 and index < len(units) - 1:
        amount /= 1024
        index += 1
    if index == 0:
        return f"{int(amount)} {units[index]}"
    return f"{amount:.1f} {units[index]}"


EXTERNAL_TRANSPORTS = {"usb", "mmc", "firewire", "thunderbolt"}
UNMOUNTABLE_FILESYSTEMS = {"", "swap", "crypto_luks", "lvm2_member"}


def volume_rows_from_lsblk(payload: dict[str, Any]) -> list[dict[str, Any]]:
    """Flatten mountable external block devices from an lsblk JSON document."""
    rows: list[dict[str, Any]] = []

    def visit(node: dict[str, Any], parent: dict[str, Any]) -> None:
        transport = str(node.get("tran") or parent.get("transport") or "").lower()
        removable = bool(node.get("rm")) or bool(parent.get("removable"))
        hotplug = bool(node.get("hotplug")) or bool(parent.get("hotplug"))
        external = bool(parent.get("external")) or removable or hotplug \
            or transport in EXTERNAL_TRANSPORTS
        model = str(node.get("model") or parent.get("model") or "").strip()
        vendor = str(node.get("vendor") or parent.get("vendor") or "").strip()
        inherited = {
            "transport": transport,
            "removable": removable,
            "hotplug": hotplug,
            "external": external,
            "model": model,
            "vendor": vendor,
        }
        children = node.get("children")
        child_nodes = children if isinstance(children, list) else []
        fstype = str(node.get("fstype") or "")
        device = str(node.get("path") or "")
        mountpoints = node.get("mountpoints")
        mount_path = ""
        if isinstance(mountpoints, list):
            mount_path = next(
                (str(value) for value in mountpoints
                 if isinstance(value, str) and value.startswith("/")),
                "",
            )
        elif isinstance(node.get("mountpoint"), str):
            value = str(node.get("mountpoint"))
            mount_path = value if value.startswith("/") else ""

        # A partitioned disk is represented by its usable child volumes. A
        # superfloppy-style USB stick has a filesystem directly on the disk.
        usable = bool(device) and external and fstype.lower() not in {"", "swap"}
        if usable and (not child_nodes or mount_path or fstype.lower() != "crypto_luks"):
            label = str(node.get("label") or "").strip()
            kernel_name = str(node.get("name") or node.get("kname") or "").strip()
            name = label or model or vendor or kernel_name or os.path.basename(device)
            try:
                size = max(0, int(node.get("size") or 0))
            except (TypeError, ValueError):
                size = 0
            rows.append({
                "id": str(node.get("uuid") or device),
                "name": display_text(name),
                "device": device,
                "deviceName": kernel_name,
                "mountPath": display_text(mount_path),
                "mountToken": encode_path(mount_path) if mount_path else "",
                "mounted": bool(mount_path),
                "fstype": fstype,
                "label": display_text(label),
                "uuid": str(node.get("uuid") or ""),
                "size": size,
                "sizeText": human_size(size),
                "transport": transport.upper(),
                "model": display_text(model),
                "vendor": display_text(vendor),
                "removable": removable,
                "hotplug": hotplug,
                "readOnly": bool(node.get("ro")),
                "canMount": not mount_path
                    and fstype.lower() not in UNMOUNTABLE_FILESYSTEMS,
                "canUnmount": bool(mount_path),
            })
        for child in child_nodes:
            if isinstance(child, dict):
                visit(child, inherited)

    devices = payload.get("blockdevices")
    for device in devices if isinstance(devices, list) else []:
        if isinstance(device, dict):
            visit(device, {})
    rows.sort(key=lambda row: (
        0 if row["mounted"] else 1,
        str(row["name"]).casefold(),
        str(row["device"]),
    ))
    return rows


def external_volumes() -> list[dict[str, Any]]:
    executable = shutil.which("lsblk")
    if not executable:
        raise QuickfileError("lsblk is not installed", "volumes-unavailable")
    code, output, error = run_bounded([
        executable,
        "--json",
        "--bytes",
        "--output",
        "NAME,KNAME,PATH,TYPE,FSTYPE,LABEL,UUID,SIZE,MOUNTPOINTS,RM,HOTPLUG,TRAN,MODEL,VENDOR,RO",
    ])
    if code != 0:
        raise QuickfileError(error.strip() or "Could not inspect storage devices", "volumes-failed")
    try:
        payload = json.loads(output)
    except json.JSONDecodeError as exc:
        raise QuickfileError("lsblk returned invalid data", "volumes-invalid") from exc
    if not isinstance(payload, dict):
        raise QuickfileError("lsblk returned invalid data", "volumes-invalid")
    return volume_rows_from_lsblk(payload)


def volumes_command(_args: argparse.Namespace) -> dict[str, Any]:
    rows = external_volumes()
    return {"ok": True, "volumes": rows, "count": len(rows)}


def volume_action_command(args: argparse.Namespace) -> dict[str, Any]:
    device = str(args.device or "")
    volumes = external_volumes()
    volume = next((row for row in volumes if row["device"] == device), None)
    if volume is None:
        raise QuickfileError("This external device is no longer available", "volume-missing")
    executable = shutil.which("udisksctl")
    if not executable:
        raise QuickfileError("udisksctl is not installed", "volume-actions-unavailable")

    if args.action == "mount":
        if volume["mounted"]:
            return {
                "ok": True,
                "action": "mount",
                "message": "Drive is already mounted",
                "volume": volume,
            }
        if not volume["canMount"]:
            raise QuickfileError("This external device cannot be mounted", "volume-not-mountable")
        command = [executable, "mount", "--block-device", device, "--no-user-interaction"]
        success_message = "Drive mounted"
    else:
        if not volume["mounted"]:
            return {
                "ok": True,
                "action": "unmount",
                "message": "Drive is already unmounted",
                "volume": volume,
            }
        command = [executable, "unmount", "--block-device", device, "--no-user-interaction"]
        success_message = "Drive safely unmounted"

    code, _, error = run_bounded(command, timeout=30)
    if code != 0:
        raise QuickfileError(
            error.strip() or f"Could not {args.action} the external device",
            f"volume-{args.action}-failed",
        )
    updated = next(
        (row for row in external_volumes() if row["device"] == device),
        dict(volume),
    )
    if args.action == "unmount":
        updated["mountPath"] = ""
        updated["mountToken"] = ""
        updated["mounted"] = False
        updated["canUnmount"] = False
    return {
        "ok": True,
        "action": args.action,
        "message": success_message,
        "volume": updated,
    }


def mime_for(path: str, mode: int) -> str:
    if stat.S_ISDIR(mode):
        return "inode/directory"
    if stat.S_ISLNK(mode):
        return "inode/symlink"
    guessed, _ = mimetypes.guess_type(display_text(path), strict=False)
    return guessed or "application/octet-stream"


def file_kind(mode: int) -> str:
    if stat.S_ISDIR(mode):
        return "directory"
    if stat.S_ISLNK(mode):
        return "symlink"
    if stat.S_ISREG(mode):
        return "file"
    if stat.S_ISSOCK(mode):
        return "socket"
    if stat.S_ISFIFO(mode):
        return "fifo"
    if stat.S_ISCHR(mode):
        return "character-device"
    if stat.S_ISBLK(mode):
        return "block-device"
    return "unknown"


def has_children(path: str) -> bool:
    try:
        with os.scandir(path) as iterator:
            next(iterator)
        return True
    except (OSError, StopIteration):
        return False


def safe_stat(path: str) -> os.stat_result:
    try:
        return os.lstat(path)
    except OSError as exc:
        raise QuickfileError(str(exc), "stat-failed") from exc


def git_context(path: str) -> dict[str, Any]:
    probe = path if os.path.isdir(path) else os.path.dirname(path)
    code, out, _ = run_bounded(["git", "-C", probe, "rev-parse", "--show-toplevel"])
    if code != 0 or not out.strip():
        return {"root": "", "branch": "", "statuses": {}}
    root = normalized_path(out.splitlines()[0])
    _, branch, _ = run_bounded(["git", "-C", root, "branch", "--show-current"])
    code, porcelain, _ = run_bounded(
        # Prevent git's optional index refresh write from feeding the watcher.
        ["git", "--no-optional-locks", "-C", root, "status", "--porcelain=v1", "--untracked-files=all"],
        timeout=5,
        limit=524288,
    )
    statuses: dict[str, str] = {}
    if code == 0:
        for line in porcelain.splitlines():
            if len(line) < 4:
                continue
            status_code = line[:2]
            rel = line[3:]
            if " -> " in rel:
                rel = rel.split(" -> ", 1)[1]
            statuses[normalized_path(os.path.join(root, rel))] = status_code
    return {
        "root": display_text(root),
        "rootToken": encode_path(root),
        "branch": branch.strip(),
        "statuses": statuses,
    }


def status_for(path: str, git: dict[str, Any]) -> str:
    statuses = git.get("statuses", {})
    exact = statuses.get(normalized_path(path))
    if exact:
        return exact
    if os.path.isdir(path):
        prefix = normalized_path(path).rstrip(os.sep) + os.sep
        for changed, code in statuses.items():
            if changed.startswith(prefix):
                return code
    return ""


def entry_row(path: str, depth: int, git: dict[str, Any], expanded: set[str]) -> dict[str, Any]:
    info = safe_stat(path)
    mode = info.st_mode
    follows_to_dir = False
    if stat.S_ISLNK(mode):
        try:
            follows_to_dir = os.path.isdir(path)
        except OSError:
            pass
    directory = stat.S_ISDIR(mode) or follows_to_dir
    name = os.path.basename(path) or path
    token = encode_path(path)
    return {
        "name": display_text(name),
        "path": display_text(path),
        "token": token,
        "uri": uri_for(path),
        "shellQuotedPath": shlex.quote(display_text(path)),
        "depth": depth,
        "kind": file_kind(mode),
        "isDir": directory,
        "isSymlink": stat.S_ISLNK(mode),
        "isHidden": name.startswith("."),
        "isExecutable": bool(mode & stat.S_IXUSR),
        "hasChildren": directory and has_children(path),
        "expanded": token in expanded,
        "size": info.st_size,
        "sizeText": human_size(info.st_size),
        "modified": iso_time(info.st_mtime),
        "modifiedEpoch": info.st_mtime,
        "permissions": stat.filemode(mode),
        "mode": f"{stat.S_IMODE(mode):04o}",
        "mime": mime_for(path, mode),
        "git": status_for(path, git),
    }


def path_within(path: str, parent: str) -> bool:
    try:
        return os.path.commonpath((normalized_path(path), normalized_path(parent))) == normalized_path(parent)
    except ValueError:
        return False


def knowledge_ancestors(root: str, home: str) -> list[str]:
    current = root if os.path.isdir(root) else os.path.dirname(root)
    current = normalized_path(current)
    boundary = normalized_path(home) if path_within(current, home) else current
    ancestors: list[str] = []
    for _ in range(32):
        ancestors.append(current)
        if current == boundary:
            break
        parent = os.path.dirname(current.rstrip(os.sep)) or os.sep
        if parent == current or not path_within(parent, boundary):
            break
        current = parent
    return ancestors


def knowledge_rule_files(directory: str, suffixes: tuple[str, ...], limit: int = 64,
                         watch: WatchPaths | None = None) -> list[str]:
    if watch is not None:
        watch.add_directory(directory)
    try:
        entries = list(os.scandir(directory))
    except OSError:
        return []
    output: list[str] = []
    for entry in sorted(entries, key=lambda item: display_text(item.name).casefold()):
        if len(output) >= limit:
            break
        try:
            if entry.is_file(follow_symlinks=True) and entry.name.lower().endswith(suffixes):
                output.append(entry.path)
        except OSError:
            continue
    return output


def knowledge_candidates(root: str, home: str,
                         watch: WatchPaths | None = None) -> list[dict[str, Any]]:
    candidates: list[dict[str, Any]] = []
    seen: set[tuple[str, str]] = set()

    def add(path: str, agent: str, scope: str, source: str) -> None:
        absolute = normalized_path(path)
        if watch is not None:
            watch.add_file(absolute)
        key = (absolute, agent)
        if key in seen or not os.path.isfile(absolute):
            return
        seen.add(key)
        candidates.append({
            "path": absolute,
            "agent": agent,
            "scope": scope,
            "source": normalized_path(source),
        })

    conventional = (
        ("CLAUDE.md", "claude"),
        ("CLAUDE.local.md", "claude"),
        (".claude/CLAUDE.md", "claude"),
        ("GEMINI.md", "gemini"),
        (".cursorrules", "cursor"),
        (".windsurfrules", "windsurf"),
    )
    for ancestor in knowledge_ancestors(root, home):
        codex_override = os.path.join(ancestor, "AGENTS.override.md")
        if watch is not None:
            watch.add_file(codex_override)
            watch.add_file(os.path.join(ancestor, "AGENTS.md"))
        add(
            codex_override if os.path.isfile(codex_override)
            else os.path.join(ancestor, "AGENTS.md"),
            "codex", "PROJECT", ancestor,
        )
        for relative, agent in conventional:
            add(os.path.join(ancestor, relative), agent, "PROJECT", ancestor)
        add(
            os.path.join(ancestor, ".github", "copilot-instructions.md"),
            "copilot", "PROJECT", ancestor,
        )
        for path in knowledge_rule_files(os.path.join(ancestor, ".cursor", "rules"), (".md", ".mdc"), watch=watch):
            add(path, "cursor", "PROJECT", ancestor)
        for path in knowledge_rule_files(os.path.join(ancestor, ".claude", "rules"), (".md",), watch=watch):
            add(path, "claude", "PROJECT", ancestor)
        for path in knowledge_rule_files(os.path.join(ancestor, ".github", "instructions"), (".md",), watch=watch):
            add(path, "copilot", "PROJECT", ancestor)
        for path in knowledge_rule_files(os.path.join(ancestor, ".devin", "rules"), (".md",), watch=watch):
            add(path, "windsurf", "PROJECT", ancestor)
        for path in knowledge_rule_files(os.path.join(ancestor, ".windsurf", "rules"), (".md",), watch=watch):
            add(path, "windsurf", "PROJECT", ancestor)

    user_codex_override = os.path.join(home, ".codex", "AGENTS.override.md")
    if watch is not None:
        watch.add_file(user_codex_override)
        watch.add_file(os.path.join(home, ".codex", "AGENTS.md"))
    add(
        user_codex_override if os.path.isfile(user_codex_override)
        else os.path.join(home, ".codex", "AGENTS.md"),
        "codex", "USER", home,
    )
    user_files = (
        (".claude/CLAUDE.md", "claude"),
        (".gemini/GEMINI.md", "gemini"),
        (".copilot/copilot-instructions.md", "copilot"),
        (".config/github-copilot/copilot-instructions.md", "copilot"),
        (".codeium/windsurf/memories/global_rules.md", "windsurf"),
    )
    for relative, agent in user_files:
        add(os.path.join(home, relative), agent, "USER", home)
    user_rule_dirs = (
        (".claude/rules", "claude", (".md",)),
        (".cursor/rules", "cursor", (".md", ".mdc")),
        (".config/Cursor/User/rules", "cursor", (".md", ".mdc")),
        (".copilot/instructions", "copilot", (".instructions.md",)),
        (".devin/rules", "windsurf", (".md",)),
        (".windsurf/rules", "windsurf", (".md",)),
    )
    for relative, agent, suffixes in user_rule_dirs:
        for path in knowledge_rule_files(os.path.join(home, relative), suffixes, watch=watch):
            add(path, agent, "USER", home)
    return candidates


def compact_home_path(path: str, home: str) -> str:
    absolute = normalized_path(path)
    if path_within(absolute, home):
        relative = os.path.relpath(absolute, home)
        return "~" if relative == "." else "~/" + display_text(relative)
    return display_text(absolute)


def knowledge_command(args: argparse.Namespace) -> dict[str, Any]:
    root = path_from_args(args, required=False)
    if not os.path.isdir(root):
        raise QuickfileError(f"Not a directory: {display_text(root)}", "not-a-directory")
    home = quickfile_home()
    limit = max(1, min(KNOWLEDGE_LIMIT, int(getattr(args, "limit", KNOWLEDGE_LIMIT))))
    metadata = load_metadata_store()
    watch = WatchPaths()
    candidates = knowledge_candidates(root, home, watch)
    for token, raw in metadata.get("items", {}).items():
        if not isinstance(raw, dict) or raw.get("knowledge") is not True:
            continue
        try:
            path = normalized_path(decode_path(str(token)))
        except QuickfileError:
            continue
        watch.add_file(path)
        if not os.path.isfile(path):
            continue
        raw_agents = raw.get("agents", [])
        agents = [
            agent for agent in raw_agents
            if isinstance(agent, str) and agent in KNOWLEDGE_AGENT_KEYS
        ] if isinstance(raw_agents, list) else []
        scope = "PROJECT" if path_within(path, root) else (
            "USER" if path_within(path, home) else "EXTERNAL"
        )
        for agent in agents or [""]:
            candidates.append({
                "path": path,
                "agent": agent,
                "scope": scope,
                "source": root if scope == "PROJECT" else (
                    home if scope == "USER" else os.path.dirname(path)
                ),
                "registered": True,
            })
    records: dict[str, dict[str, Any]] = {}
    truncated = False
    for candidate in candidates:
        canonical = normalized_path(os.path.realpath(candidate["path"]))
        if not os.path.isfile(canonical):
            continue
        canonical_token = encode_path(canonical)
        record = records.get(canonical_token)
        if record is None:
            if len(records) >= limit:
                truncated = True
                continue
            try:
                row = entry_row(canonical, 0, {"root": "", "branch": "", "statuses": {}}, set())
            except QuickfileError:
                continue
            row.update({
                "isKnowledge": True,
                "scope": candidate["scope"],
                "scopePath": display_text(candidate["source"]),
                "displayPath": compact_home_path(candidate["path"], home),
                "agents": [],
                "bindings": [],
                "hasSymlinkBinding": False,
                "symlinkTargets": [],
                "tokenEstimate": (int(row["size"]) + 3) // 4 if row["size"] else 0,
                "tokenApproximate": True,
                "metadataTokens": [],
            })
            records[canonical_token] = row
            record = row
        if candidate.get("registered") is True:
            metadata_token = encode_path(candidate["path"])
            if metadata_token not in record["metadataTokens"]:
                record["metadataTokens"].append(metadata_token)
        binding_path = candidate["path"]
        is_link = os.path.islink(binding_path)
        binding_agent = candidate["agent"] or "registry"
        binding = {
            "agent": binding_agent,
            "path": display_text(binding_path),
            "displayPath": compact_home_path(binding_path, home),
            "isSymlink": is_link,
            "target": display_text(canonical) if is_link else "",
        }
        if not any(
            current["agent"] == binding["agent"] and current["path"] == binding["path"]
            for current in record["bindings"]
        ):
            record["bindings"].append(binding)
        if candidate["agent"] and candidate["agent"] not in record["agents"]:
            record["agents"].append(candidate["agent"])
        if candidate["scope"] == "PROJECT":
            record["scope"] = "PROJECT"
            record["scopePath"] = display_text(candidate["source"])
            record["displayPath"] = compact_home_path(binding_path, home)
        if is_link:
            record["hasSymlinkBinding"] = True
            target = display_text(canonical)
            if target not in record["symlinkTargets"]:
                record["symlinkTargets"].append(target)

    order = {name: index for index, name in enumerate(KNOWLEDGE_AGENT_ORDER)}
    rows = list(records.values())
    for row in rows:
        row["agents"].sort(key=lambda name: (order.get(name, 999), name))
        row["bindings"].sort(key=lambda item: (order.get(item["agent"], 999), item["path"]))
        enrich_row(row, metadata)
        explicit_agents = set(row["knowledgeAgents"])
        for metadata_token in row.pop("metadataTokens"):
            manual = item_metadata(metadata, metadata_token)
            if manual.get("knowledge") is True:
                row["registeredKnowledge"] = True
            for agent in manual.get("agents", []):
                if isinstance(agent, str) and agent in KNOWLEDGE_AGENT_KEYS:
                    explicit_agents.add(agent)
        row["knowledgeAgents"] = [
            agent for agent in KNOWLEDGE_AGENT_ORDER if agent in explicit_agents
        ]
    rows.sort(key=lambda row: (
        {"PROJECT": 0, "USER": 1, "EXTERNAL": 2}.get(row["scope"], 3),
        str(row["scopePath"]).count(os.sep) * (-1 if row["scope"] == "PROJECT" else 1),
        str(row["name"]).casefold(),
    ))
    total_tokens = sum(int(row["tokenEstimate"]) for row in rows)
    return {
        "ok": True,
        "root": {"path": display_text(root), "token": encode_path(root)},
        "entries": rows,
        "count": len(rows),
        "totalTokens": total_tokens,
        "maxTokens": max((int(row["tokenEstimate"]) for row in rows), default=0),
        "truncated": truncated,
        "approximate": True,
        "watch": watch.payload(),
    }


def named_path_from_args(args: argparse.Namespace, name: str) -> str:
    token = getattr(args, f"{name}_token", None)
    value = getattr(args, name, None)
    if token:
        return normalized_path(decode_path(token))
    if value:
        return normalized_path(value)
    raise QuickfileError(f"A {name} path is required", f"missing-{name}")


def registered_knowledge_agents(store: dict[str, Any], source: str) -> list[str]:
    """Return explicit agent mappings for every registry alias of a file."""
    canonical = normalized_path(os.path.realpath(source))
    selected: set[str] = set()
    registered = False
    for token, raw in store.get("items", {}).items():
        if not isinstance(raw, dict) or raw.get("knowledge") is not True:
            continue
        try:
            registered_path = normalized_path(decode_path(str(token)))
        except QuickfileError:
            continue
        if normalized_path(os.path.realpath(registered_path)) != canonical:
            continue
        registered = True
        for agent in raw.get("agents", []):
            if isinstance(agent, str) and agent in KNOWLEDGE_AGENT_KEYS:
                selected.add(agent)
    if not registered:
        raise QuickfileError(
            "Register this file in Project Knowledge before creating links",
            "knowledge-not-registered",
        )
    return [agent for agent in KNOWLEDGE_AGENT_ORDER if agent in selected]


def project_root_for(path: str) -> str:
    code, output, _ = run_bounded(
        ["git", "-C", path, "rev-parse", "--show-toplevel"],
        timeout=2,
        limit=8192,
    )
    if code == 0 and output.strip():
        candidate = normalized_path(output.splitlines()[0])
        if os.path.isdir(candidate):
            return candidate
    return normalized_path(path)


def knowledge_link_slug(source: str) -> str:
    stem = os.path.splitext(os.path.basename(source))[0]
    safe = re.sub(r"[^A-Za-z0-9._-]+", "-", display_text(stem)).strip("-.").lower()
    if not safe:
        safe = "knowledge"
    digest = hashlib.sha256(os.fsencode(normalized_path(source))).hexdigest()[:8]
    return f"quickfile-{safe[:40]}-{digest}"


def native_knowledge_path(agent: str, source: str, project_root: str) -> bool:
    source = normalized_path(source)
    root = normalized_path(project_root)
    basename = os.path.basename(source)
    if os.path.dirname(source) == root:
        if agent == "codex" and basename == "AGENTS.override.md":
            return True
        if (
            agent == "codex"
            and basename == "AGENTS.md"
            and not os.path.lexists(os.path.join(root, "AGENTS.override.md"))
        ):
            return True
        if agent == "claude" and basename in {"CLAUDE.md", "CLAUDE.local.md"}:
            return True
        if agent == "gemini" and basename == "GEMINI.md":
            return True
        if agent == "cursor" and basename in {".cursorrules", "AGENTS.md", "CLAUDE.md"}:
            return True
        if agent == "copilot" and basename in {"AGENTS.md", "CLAUDE.md", "GEMINI.md"}:
            return True
        if agent == "windsurf" and basename in {"AGENTS.md", ".windsurfrules"}:
            return True
    if agent == "claude" and source == os.path.join(root, ".claude", "CLAUDE.md"):
        return True
    native_directories = {
        "claude": (os.path.join(root, ".claude", "rules"), (".md",)),
        "cursor": (os.path.join(root, ".cursor", "rules"), (".mdc",)),
        "copilot": (os.path.join(root, ".github", "instructions"), (".instructions.md",)),
        "windsurf": (os.path.join(root, ".windsurf", "rules"), (".md",)),
    }
    if agent == "windsurf" and path_within(source, os.path.join(root, ".devin", "rules")):
        return source.lower().endswith(".md")
    native = native_directories.get(agent)
    return bool(
        native
        and path_within(source, native[0])
        and source.lower().endswith(native[1])
    )


def knowledge_link_target(agent: str, source: str, project_root: str) -> str:
    root = normalized_path(project_root)
    slug = knowledge_link_slug(source)
    if agent == "codex":
        override = os.path.join(root, "AGENTS.override.md")
        return override if os.path.lexists(override) else os.path.join(root, "AGENTS.md")
    if agent == "claude":
        return os.path.join(root, ".claude", "rules", slug + ".md")
    if agent == "gemini":
        return os.path.join(root, "GEMINI.md")
    if agent == "cursor":
        return os.path.join(root, ".cursor", "rules", slug + ".mdc")
    if agent == "copilot":
        return os.path.join(root, ".github", "copilot-instructions.md")
    if agent == "windsurf":
        return os.path.join(root, ".windsurf", "rules", slug + ".md")
    raise QuickfileError("Unsupported knowledge agent", "metadata-invalid-agents")


def safe_link_parent_reason(project_root: str, target: str) -> str:
    root = normalized_path(project_root)
    parent = os.path.dirname(normalized_path(target))
    if not path_within(parent, root):
        return "Target is outside the project root"
    relative = os.path.relpath(parent, root)
    current = root
    if relative == ".":
        return ""
    for component in relative.split(os.sep):
        current = os.path.join(current, component)
        if not os.path.lexists(current):
            continue
        if os.path.islink(current):
            return f"Parent is a symbolic link: {display_text(current)}"
        if not os.path.isdir(current):
            return f"Parent is not a directory: {display_text(current)}"
    return ""


def knowledge_links_plan(source: str, root: str) -> dict[str, Any]:
    if not os.path.isfile(source):
        raise QuickfileError("Knowledge source must be an existing file", "knowledge-file-required")
    if not os.path.isdir(root):
        raise QuickfileError(f"Not a directory: {display_text(root)}", "not-a-directory")
    source = normalized_path(os.path.realpath(source))
    project_root = project_root_for(root)
    agents = registered_knowledge_agents(load_metadata_store(), source)
    entries: list[dict[str, Any]] = []
    for agent in agents:
        if native_knowledge_path(agent, source, project_root):
            target = source
            status = "connected"
            reason = "Already stored in a native agent location"
        else:
            target = knowledge_link_target(agent, source, project_root)
            parent_reason = safe_link_parent_reason(project_root, target)
            if parent_reason:
                status = "conflict"
                reason = parent_reason
            elif not os.path.lexists(target):
                status = "create"
                reason = "A new symbolic link will be created"
            else:
                try:
                    same_file = os.path.samefile(source, target)
                except OSError:
                    same_file = False
                if same_file:
                    status = "connected"
                    reason = "Already connected to this file"
                else:
                    status = "conflict"
                    reason = "Target already exists and will not be replaced"
        link_value = (
            os.path.relpath(source, os.path.dirname(target))
            if path_within(source, project_root) and target != source
            else source
        )
        warning = ""
        if agent == "cursor" and not source.lower().endswith(".mdc"):
            warning = "Cursor will expose this Markdown file as an MDC rule"
        entries.append({
            "agent": agent,
            "source": display_text(source),
            "sourceToken": encode_path(source),
            "target": display_text(target),
            "targetToken": encode_path(target),
            "relativeTarget": display_text(os.path.relpath(target, project_root)),
            "linkValue": display_text(link_value),
            "status": status,
            "reason": reason,
            "warning": warning,
        })
    counts = {
        status: sum(1 for entry in entries if entry["status"] == status)
        for status in ("create", "connected", "conflict")
    }
    return {
        "ok": True,
        "action": "knowledge-links-preview",
        "message": "Link preview ready" if entries else "No agents selected for this file",
        "source": display_text(source),
        "sourceToken": encode_path(source),
        "projectRoot": display_text(project_root),
        "projectRootToken": encode_path(project_root),
        "entries": entries,
        "createCount": counts["create"],
        "connectedCount": counts["connected"],
        "conflictCount": counts["conflict"],
    }


def create_safe_link_parent(project_root: str, target: str) -> None:
    reason = safe_link_parent_reason(project_root, target)
    if reason:
        raise QuickfileError(reason, "knowledge-link-unsafe-parent")
    root = normalized_path(project_root)
    relative = os.path.relpath(os.path.dirname(target), root)
    current = root
    if relative == ".":
        return
    for component in relative.split(os.sep):
        current = os.path.join(current, component)
        if not os.path.lexists(current):
            try:
                os.mkdir(current, mode=0o755)
            except FileExistsError:
                pass
        if os.path.islink(current) or not os.path.isdir(current):
            raise QuickfileError(
                f"Unsafe link parent: {display_text(current)}",
                "knowledge-link-unsafe-parent",
            )


def knowledge_links_command(args: argparse.Namespace) -> dict[str, Any]:
    source = named_path_from_args(args, "source")
    root = named_path_from_args(args, "root")
    plan = knowledge_links_plan(source, root)
    if not getattr(args, "apply", False):
        return plan

    errors: list[dict[str, str]] = []
    created = 0
    canonical_source = normalized_path(os.path.realpath(source))
    project_root = project_root_for(root)
    for entry in plan["entries"]:
        if entry["status"] != "create":
            continue
        target = decode_path(entry["targetToken"])
        link_value = (
            os.path.relpath(canonical_source, os.path.dirname(target))
            if path_within(canonical_source, project_root)
            else canonical_source
        )
        try:
            create_safe_link_parent(project_root, target)
            os.symlink(link_value, target)
            created += 1
        except (OSError, QuickfileError) as exc:
            errors.append({"agent": entry["agent"], "error": str(exc)})

    result = knowledge_links_plan(source, root)
    result["action"] = "knowledge-links-apply"
    result["createdCount"] = created
    result["errors"] = errors
    result["message"] = (
        f"Created {created} knowledge link" + ("s" if created != 1 else "")
        + (f"; {len(errors)} skipped" if errors else "")
    )
    return result


def scandir_sorted(path: str, show_hidden: bool) -> list[os.DirEntry[str]]:
    try:
        entries = list(os.scandir(path))
    except OSError as exc:
        raise QuickfileError(str(exc), "read-directory-failed") from exc
    if not show_hidden:
        entries = [entry for entry in entries if not entry.name.startswith(".")]

    def sort_key(entry: os.DirEntry[str]) -> tuple[int, str]:
        try:
            directory = entry.is_dir(follow_symlinks=True)
        except OSError:
            directory = False
        return (0 if directory else 1, display_text(entry.name).casefold())

    entries.sort(key=sort_key)
    return entries


def tree_command(args: argparse.Namespace) -> dict[str, Any]:
    root = path_from_args(args, required=False)
    if not os.path.isdir(root):
        raise QuickfileError(f"Not a directory: {display_text(root)}", "not-a-directory")
    expanded = set(args.expanded or [])
    git = git_context(root) if not args.no_git else {"root": "", "branch": "", "statuses": {}}
    rows: list[dict[str, Any]] = []
    truncated = False
    watch = WatchPaths()
    watch.add_git(git)

    def visit(directory: str, depth: int) -> None:
        nonlocal truncated
        watch.add_directory(directory)
        try:
            children = scandir_sorted(directory, args.show_hidden)
        except QuickfileError:
            return
        for child in children:
            if len(rows) >= args.limit:
                truncated = True
                return
            child_path = os.path.join(directory, child.name)
            try:
                row = entry_row(child_path, depth, git, expanded)
            except QuickfileError:
                continue
            rows.append(row)
            if row["isDir"] and row["token"] in expanded and depth < args.max_depth:
                visit(child_path, depth + 1)
            if truncated:
                return

    visit(root, 0)
    metadata = load_metadata_store()
    enrich_rows(rows, metadata)
    root_info = safe_stat(root)
    parent = os.path.dirname(root.rstrip(os.sep)) or os.sep
    return {
        "ok": True,
        "root": {
            "name": display_text(os.path.basename(root) or root),
            "path": display_text(root),
            "token": encode_path(root),
            "parentPath": display_text(parent),
            "parentToken": encode_path(parent),
            "permissions": stat.filemode(root_info.st_mode),
        },
        "entries": rows,
        "favorites": favorite_rows(metadata),
        "git": {key: value for key, value in git.items() if key != "statuses"},
        "truncated": truncated,
        "limit": args.limit,
        "watch": watch.payload(),
    }


def fuzzy_score(candidate: str, query: str) -> int | None:
    folded = candidate.casefold()
    needle = query.casefold()
    position = -1
    score = 0
    streak = 0
    for char in needle:
        found = folded.find(char, position + 1)
        if found < 0:
            return None
        if found == position + 1:
            streak += 1
            score += 8 + streak * 2
        else:
            streak = 0
            score -= found - position - 1
        if found == 0 or candidate[found - 1] in "/_- .":
            score += 12
        position = found
    return score - len(candidate) // 8


def matches(candidate: str, query: str, mode: str, case_sensitive: bool) -> tuple[bool, int]:
    left = candidate if case_sensitive else candidate.casefold()
    right = query if case_sensitive else query.casefold()
    if mode == "exact":
        return left == right, 1000
    if mode == "prefix":
        return left.startswith(right), 900
    if mode == "suffix":
        return left.endswith(right), 800
    if mode == "regex":
        flags = 0 if case_sensitive else re.IGNORECASE
        try:
            return re.search(query, candidate, flags) is not None, 700
        except re.error as exc:
            raise QuickfileError(f"Invalid regular expression: {exc}", "invalid-regex") from exc
    if mode == "fuzzy":
        score = fuzzy_score(candidate, query)
        return score is not None, score or 0
    return right in left, 600 - max(0, len(left) - len(right))


def content_match(
    path: str,
    query: str,
    mode: str,
    case_sensitive: bool,
    byte_limit: int,
    deadline: float,
) -> tuple[dict[str, Any] | None, int]:
    """Return one bounded text match and the number of bytes inspected."""
    if byte_limit <= 0 or time.monotonic() >= deadline:
        return None, 0
    try:
        info = os.lstat(path)
    except OSError:
        return None, 0
    if not stat.S_ISREG(info.st_mode) or info.st_size > byte_limit:
        return None, 0
    try:
        with open(path, "rb") as stream:
            raw = stream.read(byte_limit + 1)
    except OSError:
        return None, 0
    if len(raw) > byte_limit or b"\x00" in raw[:8192]:
        return None, min(len(raw), byte_limit)

    text = raw.decode("utf-8", "replace")
    content_mode = "contains" if mode == "fuzzy" else mode
    for line_number, line in enumerate(text.splitlines(), start=1):
        if time.monotonic() >= deadline:
            break
        candidate = line[:CONTENT_LINE_LIMIT]
        if content_mode in {"exact", "prefix", "suffix"}:
            candidate = candidate.strip()
        found, score = matches(candidate, query, content_mode, case_sensitive)
        if not found:
            continue
        snippet = " ".join(line.strip().split())[:CONTENT_SNIPPET_LIMIT]
        return {
            "matchKind": "content",
            "matchLine": line_number,
            "matchSnippet": display_text(snippet),
            "matchScore": score,
        }, len(raw)
    return None, len(raw)


def rg_content_candidates(
    root: str,
    query: str,
    mode: str,
    case_sensitive: bool,
    show_hidden: bool,
    file_limit: int,
    deadline: float,
) -> set[str] | None:
    """Return rg-prefiltered files, or None when Python must be used."""
    executable = shutil.which("rg")
    remaining = deadline - time.monotonic()
    if not executable or remaining < 0.15 or file_limit <= 0:
        return None
    if mode == "regex":
        try:
            re.compile(query, 0 if case_sensitive else re.IGNORECASE)
        except re.error as exc:
            raise QuickfileError(f"Invalid regular expression: {exc}", "invalid-regex") from exc
        pattern = query
        fixed = False
    elif mode == "exact":
        pattern, fixed = rf"^\s*{re.escape(query)}\s*$", False
    elif mode == "prefix":
        pattern, fixed = rf"^\s*{re.escape(query)}", False
    elif mode == "suffix":
        pattern, fixed = rf"{re.escape(query)}\s*$", False
    else:
        pattern, fixed = query, True
    argv = [
        executable, "--files-with-matches", "--null", "--no-messages", "--color", "never",
        "--max-count", "1", "--max-filesize", str(file_limit), "--glob", "!.git/**",
        "--no-ignore",
        "--case-sensitive" if case_sensitive else "--ignore-case",
    ]
    if show_hidden:
        argv.append("--hidden")
    if fixed:
        argv.append("--fixed-strings")
    argv.extend(["-e", pattern, "--", root])
    code, output, _ = run_bounded(
        argv, timeout=max(0.1, min(1.0, remaining / 3)), limit=RG_OUTPUT_LIMIT
    )
    if (code not in {0, 1} or "\ufffd" in output
            or len(output.encode("utf-8", "replace")) >= RG_OUTPUT_LIMIT):
        return None
    candidates: set[str] = set()
    for item in output.split("\0"):
        if not item:
            continue
        candidate = item if os.path.isabs(item) else os.path.join(root, item)
        candidates.add(normalized_path(candidate))
    return candidates


def search_command(args: argparse.Namespace) -> dict[str, Any]:
    root = path_from_args(args, required=False)
    query = args.query.strip()
    if not query:
        args.expanded = []
        args.max_depth = 12
        return tree_command(args)
    if not os.path.isdir(root):
        raise QuickfileError(f"Not a directory: {display_text(root)}", "not-a-directory")
    git = git_context(root) if not args.no_git else {"root": "", "branch": "", "statuses": {}}
    rows: list[tuple[int, dict[str, Any]]] = []
    truncated = False
    scanned = 0
    content_bytes_scanned = 0
    content_file_limit = max(
        0, int(getattr(args, "content_file_limit", DEFAULT_CONTENT_FILE_LIMIT))
    )
    content_byte_limit = max(
        0, int(getattr(args, "content_byte_limit", DEFAULT_CONTENT_BYTE_LIMIT))
    )
    deadline = time.monotonic() + max(0.25, float(args.timeout))
    rg_candidates = rg_content_candidates(
        root, query, args.mode, args.case_sensitive, args.show_hidden,
        content_file_limit, deadline,
    ) if content_byte_limit > 0 else None
    content_search_backend = "rg" if rg_candidates is not None else "python"
    root_depth = root.rstrip(os.sep).count(os.sep)
    watch = WatchPaths()
    watch.add_git(git)
    for directory, dirnames, filenames in os.walk(root, followlinks=False):
        watch.add_directory(directory)
        if not args.show_hidden:
            dirnames[:] = [name for name in dirnames if not name.startswith(".")]
            filenames = [name for name in filenames if not name.startswith(".")]
        if ".git" in dirnames:
            dirnames.remove(".git")
        for name in dirnames + filenames:
            scanned += 1
            if scanned > args.scan_limit or time.monotonic() >= deadline:
                truncated = True
                break
            path = os.path.join(directory, name)
            relative = os.path.relpath(path, root)
            rendered_name = display_text(name)
            rendered_relative = display_text(relative)
            is_directory = name in dirnames
            found, score = matches(rendered_name, query, args.mode, args.case_sensitive)
            match: dict[str, Any] | None = None
            if found:
                match = {
                    "matchKind": "folder" if is_directory else "name",
                    "matchLine": 0,
                    "matchSnippet": "",
                }
                score += 2500 if is_directory else 2400
            elif rendered_relative != rendered_name:
                found, score = matches(
                    rendered_relative, query, args.mode, args.case_sensitive
                )
                if found:
                    match = {
                        "matchKind": "path",
                        "matchLine": 0,
                        "matchSnippet": "",
                    }
                    score += 1800

            if (match is None and not is_directory
                    and content_bytes_scanned < content_byte_limit
                    and (rg_candidates is None or normalized_path(path) in rg_candidates)):
                remaining = content_byte_limit - content_bytes_scanned
                per_file_limit = min(content_file_limit, remaining)
                match, bytes_read = content_match(
                    path,
                    query,
                    args.mode,
                    args.case_sensitive,
                    per_file_limit,
                    deadline,
                )
                content_bytes_scanned += bytes_read
                if match is not None:
                    score = 1000 + max(-200, int(match.pop("matchScore", 0)))
            if match is None:
                continue
            try:
                row = entry_row(path, max(0, directory.count(os.sep) - root_depth), git, set())
            except QuickfileError:
                continue
            row["relativePath"] = rendered_relative
            row.update(match)
            rows.append((score, row))
            if len(rows) >= args.limit:
                truncated = True
                break
        if truncated:
            break
    rows.sort(key=lambda pair: (-pair[0], pair[1]["relativePath"].casefold()))
    metadata = load_metadata_store()
    result_rows = [row for _, row in rows]
    enrich_rows(result_rows, metadata)
    return {
        "ok": True,
        "root": {"path": display_text(root), "token": encode_path(root)},
        "entries": result_rows,
        "favorites": favorite_rows(metadata),
        "git": {key: value for key, value in git.items() if key != "statuses"},
        "query": query,
        "mode": args.mode,
        "truncated": truncated,
        "scanned": scanned,
        "contentBytesScanned": content_bytes_scanned,
        "contentSearchBackend": content_search_backend,
        "engine": content_search_backend,
        "limit": args.limit,
        "watch": watch.payload(),
    }


def uid_name(uid: int) -> str:
    try:
        return pwd.getpwuid(uid).pw_name
    except KeyError:
        return str(uid)


def gid_name(gid: int) -> str:
    try:
        return grp.getgrgid(gid).gr_name
    except KeyError:
        return str(gid)


def mount_for(path: str) -> dict[str, str]:
    best: dict[str, str] = {}
    try:
        with open("/proc/self/mountinfo", "r", encoding="utf-8", errors="replace") as stream:
            for line in stream:
                fields = line.rstrip("\n").split(" ")
                if "-" not in fields or len(fields) < 10:
                    continue
                separator = fields.index("-")
                mountpoint = fields[4].replace("\\040", " ").replace("\\011", "\t")
                candidate = normalized_path(mountpoint)
                absolute = normalized_path(path)
                if absolute != candidate and not absolute.startswith(candidate.rstrip(os.sep) + os.sep):
                    continue
                if not best or len(candidate) > len(best["mountpoint"]):
                    best = {
                        "mountpoint": display_text(candidate),
                        "filesystem": fields[separator + 1] if separator + 1 < len(fields) else "",
                        "source": fields[separator + 2] if separator + 2 < len(fields) else "",
                        "options": fields[5],
                    }
    except OSError:
        pass
    return best


def xattrs_for(path: str) -> list[dict[str, str]]:
    output: list[dict[str, str]] = []
    try:
        names = os.listxattr(path, follow_symlinks=False)
    except OSError:
        return output
    for name in names[:128]:
        value = b""
        try:
            value = os.getxattr(path, name, follow_symlinks=False)[:4096]
        except OSError:
            pass
        try:
            rendered = value.decode("utf-8")
            encoding = "utf-8"
        except UnicodeDecodeError:
            rendered = base64.b64encode(value).decode("ascii")
            encoding = "base64"
        output.append({"name": display_text(name), "value": rendered, "encoding": encoding})
    return output


def parse_gio_attributes(raw: str) -> dict[str, str]:
    attributes: dict[str, str] = {}
    in_attributes = False
    for line in raw.splitlines():
        if line.strip() == "attributes:":
            in_attributes = True
            continue
        if not in_attributes:
            continue
        stripped = line.strip()
        if not stripped or ": " not in stripped:
            continue
        key, _, value = stripped.partition(": ")
        if "::" in key:
            attributes[key] = value
    return attributes


def read_proc_text(path: Path, limit: int = 4096) -> str:
    try:
        with path.open("rb") as stream:
            raw = stream.read(limit + 1)
    except OSError:
        return ""
    if len(raw) > limit:
        return ""
    return raw.decode("utf-8", "replace").strip()


def proc_elapsed_seconds(process_dir: Path, proc_root: Path) -> int | None:
    raw_stat = read_proc_text(process_dir / "stat")
    raw_uptime = read_proc_text(proc_root / "uptime", 256)
    closing = raw_stat.rfind(")")
    if closing < 0 or not raw_uptime:
        return None
    fields = raw_stat[closing + 1:].strip().split()
    try:
        start_ticks = int(fields[19])
        uptime = float(raw_uptime.split()[0])
        ticks = int(os.sysconf("SC_CLK_TCK"))
    except (IndexError, ValueError, OSError):
        return None
    if ticks <= 0:
        return None
    return max(0, int(uptime - start_ticks / ticks))


def path_relation(scope: str, cwd: str) -> str:
    try:
        common = os.path.commonpath((scope, cwd))
    except ValueError:
        return ""
    if scope == cwd:
        return "this folder"
    if common == scope:
        relative = os.path.relpath(cwd, scope)
        return display_text(relative) if relative != "." else "this folder"
    if common == cwd:
        return "parent workspace"
    return ""


def active_session_rows(
    scope: str,
    *,
    proc_root: Path = Path("/proc"),
    limit: int = ACTIVE_SESSION_LIMIT,
) -> list[dict[str, Any]]:
    """Return bounded, terminal-backed agent processes related to *scope*.

    Detection is deliberately conservative: only an allowlisted executable
    name attached to a terminal counts. Knowledge files and command contents
    are never used as evidence that a session is running.
    """
    scope_path = os.path.realpath(normalized_path(scope))
    bounded_limit = max(0, min(limit, ACTIVE_SESSION_LIMIT))
    if bounded_limit == 0:
        return []
    try:
        process_dirs = []
        with os.scandir(proc_root) as entries:
            for entry in entries:
                if entry.name.isdigit():
                    process_dirs.append(Path(entry.path))
                    if len(process_dirs) >= ACTIVE_SESSION_PROCESS_LIMIT:
                        break
        process_dirs.sort(key=lambda entry: int(entry.name))
    except OSError:
        return []
    rows: list[dict[str, Any]] = []
    for process_dir in process_dirs:
        comm = read_proc_text(process_dir / "comm", 256)
        adapter = ACTIVE_SESSION_AGENTS.get(comm.casefold())
        if adapter is None:
            continue
        try:
            stdin_target = os.readlink(process_dir / "fd" / "0")
        except OSError:
            continue
        if not (stdin_target.startswith("/dev/pts/") or stdin_target.startswith("/dev/tty")):
            continue
        try:
            cwd = os.path.realpath(os.readlink(process_dir / "cwd"))
        except OSError:
            continue
        relation = path_relation(scope_path, cwd)
        if not relation:
            continue
        agent, label = adapter
        age = proc_elapsed_seconds(process_dir, proc_root)
        rows.append({
            "sessionKey": f"{agent}:{process_dir.name}",
            "agent": agent,
            "label": label,
            "pid": int(process_dir.name),
            "cwd": display_text(cwd),
            "cwdToken": encode_path(cwd),
            "location": relation,
            "ageSeconds": age if age is not None else -1,
            "terminal": display_text(stdin_target),
        })
        if len(rows) >= bounded_limit:
            break
    rows.sort(key=lambda row: (row["agent"], row["pid"]))
    return rows


def sessions_command(args: argparse.Namespace) -> dict[str, Any]:
    root = path_from_args(args, required=False)
    limit = max(1, min(int(getattr(args, "limit", ACTIVE_SESSION_LIMIT)), ACTIVE_SESSION_LIMIT))
    rows = active_session_rows(root, limit=limit)
    return {
        "ok": True,
        "root": {"path": display_text(root), "token": encode_path(root)},
        "sessions": rows,
        "truncated": len(rows) >= limit,
        "detection": "terminal-processes",
    }


def properties_command(args: argparse.Namespace) -> dict[str, Any]:
    path = path_from_args(args)
    info = safe_stat(path)
    mode = info.st_mode
    symlink_target = ""
    if stat.S_ISLNK(mode):
        try:
            symlink_target = display_text(os.readlink(path))
        except OSError:
            pass
    birth = getattr(info, "st_birthtime", None)
    mount = mount_for(path)
    try:
        usage = shutil.disk_usage(path if os.path.isdir(path) else os.path.dirname(path))
        filesystem_usage = {
            "total": usage.total,
            "used": usage.used,
            "free": usage.free,
            "totalText": human_size(usage.total),
            "freeText": human_size(usage.free),
        }
    except OSError:
        filesystem_usage = {}
    acl_code, acl, _ = run_bounded(["getfacl", "-cp", "--", path], limit=32768)
    attr_code, attrs, _ = run_bounded(["lsattr", "-d", "--", path], limit=8192)
    gio_code, gio, _ = run_bounded(
        ["gio", "info", "-a", "standard::*,time::*,unix::*,filesystem::*", "--", path],
        limit=65536,
    )
    gio_attributes = parse_gio_attributes(gio) if gio_code == 0 else {}
    content_type = gio_attributes.get("standard::content-type", "")
    created_epoch = gio_attributes.get("time::created", "")
    if birth is None and created_epoch:
        try:
            birth = float(created_epoch)
        except ValueError:
            pass
    git = git_context(path)
    child_count: int | None = None
    if os.path.isdir(path):
        try:
            with os.scandir(path) as iterator:
                child_count = sum(1 for _ in iterator)
        except OSError:
            pass
    properties = {
        "name": display_text(os.path.basename(path) or path),
        "path": display_text(path),
        "token": encode_path(path),
        "uri": uri_for(path),
        "kind": file_kind(mode),
        "mime": content_type or mime_for(path, mode),
        "size": info.st_size,
        "sizeText": human_size(info.st_size),
        "allocatedSize": getattr(info, "st_blocks", 0) * 512,
        "allocatedSizeText": human_size(getattr(info, "st_blocks", 0) * 512),
        "permissions": stat.filemode(mode),
        "mode": f"{stat.S_IMODE(mode):04o}",
        "owner": uid_name(info.st_uid),
        "ownerId": info.st_uid,
        "group": gid_name(info.st_gid),
        "groupId": info.st_gid,
        "inode": info.st_ino,
        "device": info.st_dev,
        "hardLinks": info.st_nlink,
        "accessed": iso_time(info.st_atime),
        "modified": iso_time(info.st_mtime),
        "metadataChanged": iso_time(info.st_ctime),
        "created": iso_time(birth),
        "isReadable": os.access(path, os.R_OK),
        "isWritable": os.access(path, os.W_OK),
        "isExecutable": os.access(path, os.X_OK),
        "isSymlink": stat.S_ISLNK(mode),
        "symlinkTarget": symlink_target,
        "resolvedPath": display_text(os.path.realpath(path)),
        "children": child_count,
        "mount": mount,
        "filesystemUsage": filesystem_usage,
        "xattrs": xattrs_for(path),
        "acl": acl if acl_code == 0 else "",
        "fileAttributes": attrs.strip() if attr_code == 0 else "",
        "gio": gio if gio_code == 0 else "",
        "gioAttributes": gio_attributes,
        "git": {
            "root": git.get("root", ""),
            "branch": git.get("branch", ""),
            "status": status_for(path, git),
        },
    }
    metadata_store = load_metadata_store()
    metadata = item_metadata(metadata_store, encode_path(path))
    try:
        knowledge_agents = registered_knowledge_agents(metadata_store, path)
        registered_knowledge = True
    except QuickfileError as exc:
        if exc.code != "knowledge-not-registered":
            raise
        knowledge_agents = []
        registered_knowledge = False
    properties.update({
        "color": str(metadata.get("color", "")),
        "note": str(metadata.get("note", "")),
        "starred": metadata.get("starred") is True,
        "registeredKnowledge": registered_knowledge,
        "knowledgeAgents": knowledge_agents,
    })
    return {"ok": True, "properties": properties}


def image_dimensions(raw: bytes) -> tuple[int, int]:
    """Read common image dimensions from a bounded header without decoders."""
    if raw.startswith(b"\x89PNG\r\n\x1a\n") and len(raw) >= 24:
        return int.from_bytes(raw[16:20], "big"), int.from_bytes(raw[20:24], "big")
    if raw[:6] in {b"GIF87a", b"GIF89a"} and len(raw) >= 10:
        return int.from_bytes(raw[6:8], "little"), int.from_bytes(raw[8:10], "little")
    if raw.startswith(b"RIFF") and raw[8:12] == b"WEBP" and len(raw) >= 30:
        kind = raw[12:16]
        if kind == b"VP8X":
            return (
                1 + int.from_bytes(raw[24:27], "little"),
                1 + int.from_bytes(raw[27:30], "little"),
            )
    if raw.startswith(b"\xff\xd8"):
        position = 2
        sof = {0xC0, 0xC1, 0xC2, 0xC3, 0xC5, 0xC6, 0xC7,
               0xC9, 0xCA, 0xCB, 0xCD, 0xCE, 0xCF}
        while position + 9 <= len(raw):
            if raw[position] != 0xFF:
                position += 1
                continue
            marker = raw[position + 1]
            position += 2
            if marker in {0xD8, 0xD9} or 0xD0 <= marker <= 0xD7:
                continue
            if position + 2 > len(raw):
                break
            length = int.from_bytes(raw[position:position + 2], "big")
            if length < 2 or position + length > len(raw):
                break
            if marker in sof and length >= 7:
                return (
                    int.from_bytes(raw[position + 5:position + 7], "big"),
                    int.from_bytes(raw[position + 3:position + 5], "big"),
                )
            position += length
    return 0, 0


def inline_preview_command(args: argparse.Namespace) -> dict[str, Any]:
    path = path_from_args(args)
    info = safe_stat(path)
    mode = info.st_mode
    mime = mime_for(path, mode)
    preview: dict[str, Any] = {
        "kind": "metadata",
        "path": display_text(path),
        "token": encode_path(path),
        "name": display_text(os.path.basename(path) or path),
        "mime": mime,
        "size": info.st_size,
        "sizeText": human_size(info.st_size),
        "modified": iso_time(info.st_mtime),
        "permissions": stat.filemode(mode),
        "uri": uri_for(path),
    }
    if stat.S_ISDIR(mode):
        children: list[dict[str, Any]] = []
        truncated = False
        visited = 0
        try:
            with os.scandir(path) as iterator:
                for child in iterator:
                    visited += 1
                    if len(children) >= PREVIEW_DIRECTORY_LIMIT:
                        truncated = True
                        break
                    if visited > PREVIEW_DIRECTORY_LIMIT * 2:
                        truncated = True
                        break
                    try:
                        child_info = child.stat(follow_symlinks=False)
                    except OSError:
                        continue
                    children.append({
                        "name": display_text(child.name),
                        "path": display_text(child.path),
                        "token": encode_path(child.path),
                        "kind": file_kind(child_info.st_mode),
                        "isDir": child.is_dir(follow_symlinks=True),
                        "size": child_info.st_size,
                    })
        except OSError as exc:
            raise QuickfileError(str(exc), "preview-read-failed") from exc
        children.sort(key=lambda row: (not row["isDir"], row["name"].casefold()))
        preview.update(kind="directory", entries=children, truncated=truncated)
        return {"ok": True, "preview": preview}
    if not stat.S_ISREG(mode):
        if stat.S_ISLNK(mode):
            try:
                preview["symlinkTarget"] = display_text(os.readlink(path))
            except OSError:
                preview["symlinkTarget"] = ""
        return {"ok": True, "preview": preview}

    read_limit = min(PREVIEW_READ_LIMIT, max(1024, int(getattr(args, "byte_limit", PREVIEW_READ_LIMIT))))
    try:
        with open(path, "rb") as stream:
            raw = stream.read(read_limit + 1)
    except OSError as exc:
        raise QuickfileError(str(exc), "preview-read-failed") from exc
    bounded = raw[:read_limit]
    if mime.startswith("image/"):
        width, height = image_dimensions(bounded)
        preview.update(
            kind="image", width=width, height=height,
            bytesRead=len(bounded), truncated=len(raw) > read_limit,
        )
        return {"ok": True, "preview": preview}

    textual_mime = (
        mime.startswith("text/")
        or mime in {"application/json", "application/xml", "application/javascript",
                    "application/x-sh", "application/toml", "application/yaml"}
    )
    decoded = ""
    likely_text = textual_mime or not bounded
    if b"\x00" not in bounded[:8192] and not likely_text:
        try:
            strict = bounded.decode("utf-8")
            sample = strict[:4096]
            printable = sum(char.isprintable() or char in "\r\n\t" for char in sample)
            likely_text = not sample or printable / len(sample) >= 0.85
            decoded = strict
        except UnicodeDecodeError:
            pass
    if b"\x00" not in bounded[:8192] and likely_text:
        if not decoded:
            decoded = bounded.decode("utf-8", "replace")
        rendered = display_text(decoded[:PREVIEW_TEXT_LIMIT])
        preview.update(
            kind="text", text=rendered, bytesRead=len(bounded),
            truncated=len(raw) > read_limit or len(decoded) > PREVIEW_TEXT_LIMIT,
        )
    else:
        preview.update(bytesRead=len(bounded), truncated=len(raw) > read_limit)
    return {"ok": True, "preview": preview}


def metadata_command(args: argparse.Namespace) -> dict[str, Any]:
    path = path_from_args(args)
    safe_stat(path)
    color = getattr(args, "color", None)
    note = getattr(args, "note", None)
    starred_text = getattr(args, "starred", None)
    knowledge_text = getattr(args, "knowledge", None)
    agents_json = getattr(args, "agents_json", None)
    if (
        color is None
        and note is None
        and starred_text is None
        and knowledge_text is None
        and agents_json is None
    ):
        raise QuickfileError("No metadata change was requested", "metadata-empty")
    if (
        color is not None
        and color != ""
        and color not in COLOR_KEYS
        and not re.fullmatch(r"#[0-9A-Fa-f]{6}", color)
    ):
        raise QuickfileError(
            "Color must be a theme color, empty, or #RRGGBB",
            "metadata-invalid-color",
        )
    if note is not None:
        if "\x00" in note:
            raise QuickfileError("A note cannot contain a NUL byte", "metadata-invalid-note")
        if len(note) > NOTE_LENGTH_LIMIT:
            raise QuickfileError(
                f"A note cannot exceed {NOTE_LENGTH_LIMIT} characters",
                "metadata-note-too-long",
            )
    agents: list[str] | None = None
    if agents_json is not None:
        try:
            raw_agents = json.loads(agents_json)
        except json.JSONDecodeError as exc:
            raise QuickfileError(
                "Knowledge agents must be a JSON list",
                "metadata-invalid-agents",
            ) from exc
        if not isinstance(raw_agents, list) or len(raw_agents) > len(KNOWLEDGE_AGENT_ORDER):
            raise QuickfileError(
                "Knowledge agents must be a JSON list of supported agents",
                "metadata-invalid-agents",
            )
        selected: set[str] = set()
        for agent in raw_agents:
            if not isinstance(agent, str) or agent not in KNOWLEDGE_AGENT_KEYS:
                raise QuickfileError(
                    "Unsupported knowledge agent",
                    "metadata-invalid-agents",
                )
            selected.add(agent)
        agents = [agent for agent in KNOWLEDGE_AGENT_ORDER if agent in selected]
    if knowledge_text == "true" and not os.path.isfile(path):
        raise QuickfileError(
            "Only files can be added to Knowledge",
            "knowledge-file-required",
        )

    store = load_metadata_store()
    items = store["items"]
    token = encode_path(path)
    record = dict(item_metadata(store, token))
    if color is not None:
        record["color"] = color.lower()
    if note is not None:
        record["note"] = note
    if starred_text is not None:
        starred = starred_text == "true"
        if starred and record.get("starred") is not True:
            record["starredAt"] = iso_time(time.time())
        record["starred"] = starred
    if knowledge_text is not None:
        registered = knowledge_text == "true"
        record["knowledge"] = registered
        if not registered:
            record.pop("agents", None)
    if agents is not None:
        if knowledge_text != "false":
            record["agents"] = agents
    record["path"] = display_text(path)
    record["updatedAt"] = iso_time(time.time())
    if (
        not record.get("color")
        and not record.get("note")
        and record.get("starred") is not True
        and record.get("knowledge") is not True
    ):
        items.pop(token, None)
        record = {}
    else:
        items[token] = record
    save_metadata_store(store)
    return {
        "ok": True,
        "action": "metadata",
        "message": "Metadata saved",
        "metadata": {
            "color": str(record.get("color", "")),
            "note": str(record.get("note", "")),
            "starred": record.get("starred") is True,
            "registeredKnowledge": record.get("knowledge") is True,
            "knowledgeAgents": [
                agent for agent in record.get("agents", [])
                if isinstance(agent, str) and agent in KNOWLEDGE_AGENT_KEYS
            ] if isinstance(record.get("agents", []), list) else [],
        },
    }


def rebase_metadata_records(store: dict[str, Any], source: str, target: str) -> bool:
    items = store.get("items", {})
    source = normalized_path(source)
    target = normalized_path(target)
    changed = False
    replacements: list[tuple[str, str, dict[str, Any]]] = []
    prefix = source.rstrip(os.sep) + os.sep
    for token, raw in list(items.items()):
        if not isinstance(raw, dict):
            continue
        try:
            stored_path = normalized_path(decode_path(str(token)))
        except QuickfileError:
            continue
        if stored_path == source:
            rebased = target
        elif stored_path.startswith(prefix):
            rebased = target.rstrip(os.sep) + stored_path[len(source):]
        else:
            continue
        record = dict(raw)
        record["path"] = display_text(rebased)
        record["updatedAt"] = iso_time(time.time())
        replacements.append((str(token), encode_path(rebased), record))
    for old_token, new_token, record in replacements:
        items.pop(old_token, None)
        items[new_token] = record
        changed = True
    return changed


def require_name(name: str) -> str:
    if not name or name in {".", ".."} or os.sep in name or "\x00" in name:
        raise QuickfileError("Invalid filename", "invalid-name")
    return name


def destination_from_args(args: argparse.Namespace) -> str:
    token = getattr(args, "destination_token", None)
    value = getattr(args, "destination", None)
    if token:
        return normalized_path(decode_path(token))
    if value:
        return normalized_path(value)
    raise QuickfileError("A destination path is required", "missing-destination")


def local_file_uri_path(uri: str) -> str:
    if not isinstance(uri, str) or len(uri) > 16384 or "\x00" in uri:
        raise QuickfileError("Invalid dropped file URI", "invalid-source-uri")
    try:
        parsed = urllib.parse.urlsplit(uri)
        raw_path = urllib.parse.unquote_to_bytes(parsed.path)
    except (UnicodeError, ValueError) as exc:
        raise QuickfileError("Invalid dropped file URI", "invalid-source-uri") from exc
    if (parsed.scheme.lower() != "file" or parsed.netloc not in {"", "localhost"}
            or parsed.query or parsed.fragment or not raw_path.startswith(b"/")
            or b"\x00" in raw_path):
        raise QuickfileError("Only local file:// URIs can be dropped", "invalid-source-uri")
    return normalized_path(os.fsdecode(raw_path))


def action_paths_from_args(args: argparse.Namespace) -> list[str]:
    raw = getattr(args, "path_tokens_json", None)
    uri_raw = getattr(args, "source_uris_json", None)
    if uri_raw is not None and (
            raw is not None or getattr(args, "path_token", None) or getattr(args, "path", None)):
        raise QuickfileError("Use one dropped-item representation", "invalid-path-list")
    if uri_raw is not None:
        try:
            uris = json.loads(uri_raw)
        except json.JSONDecodeError as exc:
            raise QuickfileError("Invalid dropped-file list", "invalid-source-uri-list") from exc
        if not isinstance(uris, list) or not uris or len(uris) > 500:
            raise QuickfileError(
                "Drop between 1 and 500 local files", "invalid-source-uri-list"
            )
        raw_paths = []
        for uri in uris:
            if not isinstance(uri, str):
                raise QuickfileError("Invalid dropped-file list", "invalid-source-uri-list")
            raw_paths.append(local_file_uri_path(uri))
    elif raw is None:
        return [path_from_args(args)]
    else:
        try:
            tokens = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise QuickfileError("Invalid selected-path list", "invalid-path-list") from exc
        if not isinstance(tokens, list) or not tokens or len(tokens) > 500:
            raise QuickfileError("Select between 1 and 500 items", "invalid-path-list")
        raw_paths = []
        for token in tokens:
            if not isinstance(token, str):
                raise QuickfileError("Invalid selected-path list", "invalid-path-list")
            raw_paths.append(normalized_path(decode_path(token)))
    paths: list[str] = []
    seen: set[str] = set()
    for path in raw_paths:
        if path not in seen:
            seen.add(path)
            paths.append(path)
    return paths


def operation_history_file() -> Path:
    override = os.environ.get("QUICKFILE_STATE_FILE", "").strip()
    if override:
        return Path(override).expanduser()
    state_home = os.environ.get("XDG_STATE_HOME", "").strip()
    base = Path(state_home).expanduser() if state_home else Path.home() / ".local" / "state"
    return base / "omarchy" / "quickfile" / "operations.json"


def load_operation_history() -> list[dict[str, Any]]:
    path = operation_history_file()
    try:
        if not path.exists():
            return []
        if path.stat().st_size > OPERATION_HISTORY_SIZE_LIMIT:
            raise QuickfileError("Operation history is too large", "history-too-large")
        payload = json.loads(path.read_text(encoding="utf-8"))
    except QuickfileError:
        raise
    except (OSError, UnicodeError, json.JSONDecodeError) as exc:
        raise QuickfileError(f"Could not read operation history: {exc}", "history-read-failed") from exc
    if not isinstance(payload, dict) or not isinstance(payload.get("operations"), list):
        raise QuickfileError("Operation history has an invalid format", "history-invalid")
    return [item for item in payload["operations"] if isinstance(item, dict)][-OPERATION_HISTORY_LIMIT:]


def save_operation_history(operations: list[dict[str, Any]]) -> None:
    path = operation_history_file()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    payload = json.dumps(
        {"version": 1, "operations": operations[-OPERATION_HISTORY_LIMIT:]},
        ensure_ascii=True,
        separators=(",", ":"),
    ) + "\n"
    if len(payload.encode("utf-8")) > OPERATION_HISTORY_SIZE_LIMIT:
        raise QuickfileError("Operation history is too large", "history-too-large")
    descriptor, temporary = tempfile.mkstemp(prefix=".operations.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            stream.write(payload)
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    except OSError as exc:
        raise QuickfileError(f"Could not save operation history: {exc}", "history-write-failed") from exc
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def record_operation(kind: str, label: str, inverse: dict[str, Any]) -> dict[str, Any]:
    operations = load_operation_history()
    record = {
        "id": uuid.uuid4().hex,
        "kind": kind,
        "label": label,
        "createdAt": iso_time(time.time()),
        "inverse": inverse,
    }
    operations.append(record)
    save_operation_history(operations)
    return record


def history_command(_args: argparse.Namespace) -> dict[str, Any]:
    operations = load_operation_history()
    last = operations[-1] if operations else None
    return {
        "ok": True,
        "undoAvailable": last is not None,
        "operation": {
            "id": str(last.get("id", "")),
            "kind": str(last.get("kind", "")),
            "label": str(last.get("label", "")),
        } if last else None,
    }


def rename_noreplace(source: str, target: str) -> bool:
    """Atomically rename *source* without ever replacing *target* on Linux."""
    source = normalized_path(source)
    target = normalized_path(target)
    if source == target:
        return False
    try:
        libc = ctypes.CDLL(None, use_errno=True)
        renameat2 = libc.renameat2
    except (OSError, AttributeError):
        renameat2 = None
    if renameat2 is not None:
        renameat2.argtypes = (
            ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint,
        )
        renameat2.restype = ctypes.c_int
        result = renameat2(-100, os.fsencode(source), -100, os.fsencode(target), 1)
        if result == 0:
            return True
        error = ctypes.get_errno()
        if error in {errno.EEXIST, errno.ENOTEMPTY}:
            raise QuickfileError(
                f'“{display_text(os.path.basename(target))}” already exists',
                "name-conflict",
            )
        raise OSError(error, os.strerror(error), source, target)

    # Safe fallback for non-directories. It preserves the no-clobber guarantee,
    # although Linux installations used by Omarchy normally provide renameat2.
    if os.path.isdir(source) and not os.path.islink(source):
        raise QuickfileError("Safe folder rename is unavailable on this system", "safe-rename-unavailable")
    try:
        os.link(source, target, follow_symlinks=False)
    except FileExistsError as exc:
        raise QuickfileError(
            f'“{display_text(os.path.basename(target))}” already exists', "name-conflict"
        ) from exc
    try:
        os.unlink(source)
    except OSError:
        os.unlink(target)
        raise
    return True


def path_identity(path: str) -> dict[str, Any]:
    details = os.lstat(path)
    identity = {
        "device": details.st_dev,
        "inode": details.st_ino,
        "mode": stat.S_IFMT(details.st_mode),
        "size": details.st_size,
        "mtimeNs": details.st_mtime_ns,
    }
    if stat.S_ISDIR(details.st_mode):
        digest = hashlib.sha256()
        pending = [(path, "", 0)]
        count = 0
        while pending:
            check_operation_cancelled()
            current, relative, depth = pending.pop()
            if depth > OPERATION_DEPTH_LIMIT or count >= OPERATION_ENTRY_LIMIT:
                raise QuickfileError("Folder changed beyond the safe undo limit", "undo-scan-limit")
            current_stat = os.lstat(current)
            digest.update(os.fsencode(relative))
            digest.update(b"\0")
            digest.update(
                f"{stat.S_IFMT(current_stat.st_mode)}:{current_stat.st_dev}:"
                f"{current_stat.st_ino}:{current_stat.st_size}:{current_stat.st_mtime_ns}".encode("ascii")
            )
            if stat.S_ISLNK(current_stat.st_mode):
                digest.update(b"\0" + os.fsencode(os.readlink(current)))
            elif stat.S_ISDIR(current_stat.st_mode):
                with os.scandir(current) as iterator:
                    children = sorted(iterator, key=lambda entry: os.fsencode(entry.name), reverse=True)
                for child in children:
                    child_relative = os.path.join(relative, child.name) if relative else child.name
                    pending.append((child.path, child_relative, depth + 1))
            count += 1
        identity["treeHash"] = digest.hexdigest()
        identity["treeItems"] = count
    return identity


def identity_matches(path: str, expected: dict[str, Any]) -> bool:
    try:
        return path_identity(path) == expected
    except OSError:
        return False


def discard_history_referencing_trash(uris: set[str]) -> None:
    if not uris:
        return
    operations = load_operation_history()
    kept = []
    for record in operations:
        inverse = record.get("inverse", {})
        items = inverse.get("items", []) if isinstance(inverse, dict) else []
        references = {
            str(item.get("uri", "")) for item in items if isinstance(item, dict)
        }
        if references.isdisjoint(uris):
            kept.append(record)
    if len(kept) != len(operations):
        save_operation_history(kept)


_operation_cancelled = False


def request_operation_cancel(_signum: int, _frame: Any) -> None:
    global _operation_cancelled
    _operation_cancelled = True


def check_operation_cancelled() -> None:
    if _operation_cancelled:
        raise OperationCancelled()


class OperationReporter:
    def __init__(self, callback: Any = json_print) -> None:
        self.callback = callback
        self.last_emit = 0.0

    def emit(self, phase: str, *, force: bool = False, **values: Any) -> None:
        now = time.monotonic()
        if not force and now - self.last_emit < 0.08:
            return
        self.last_emit = now
        self.callback({"event": "progress", "phase": phase, **values})


def scan_copy_source(source: str, reporter: OperationReporter) -> tuple[list[dict[str, Any]], int]:
    source = normalized_path(source)
    entries: list[dict[str, Any]] = []
    total_bytes = 0

    def visit(path: str, relative: str, depth: int) -> None:
        nonlocal total_bytes
        check_operation_cancelled()
        if depth > OPERATION_DEPTH_LIMIT:
            raise QuickfileError("Folder nesting is too deep to copy safely", "copy-depth-limit")
        if len(entries) >= OPERATION_ENTRY_LIMIT:
            raise QuickfileError(
                f"Folder contains more than {OPERATION_ENTRY_LIMIT:,} items",
                "copy-entry-limit",
            )
        details = os.lstat(path)
        if stat.S_ISLNK(details.st_mode):
            kind = "link"
            size = 0
        elif stat.S_ISDIR(details.st_mode):
            kind = "directory"
            size = 0
        elif stat.S_ISREG(details.st_mode):
            kind = "file"
            size = details.st_size
            total_bytes += size
        else:
            raise QuickfileError(
                f'“{display_text(os.path.basename(path))}” is a special file and cannot be copied',
                "unsupported-file-type",
            )
        entries.append({"path": path, "relative": relative, "kind": kind, "size": size})
        reporter.emit("scanning", itemsDone=len(entries), itemsTotal=-1,
                      bytesDone=total_bytes, bytesTotal=-1)
        if kind == "directory":
            with os.scandir(path) as iterator:
                for child in iterator:
                    child_relative = os.path.join(relative, child.name) if relative else child.name
                    visit(child.path, child_relative, depth + 1)

    visit(source, "", 0)
    reporter.emit("scanning", force=True, itemsDone=len(entries), itemsTotal=len(entries),
                  bytesDone=total_bytes, bytesTotal=total_bytes)
    return entries, total_bytes


def remove_created_path(path: str) -> None:
    if os.path.islink(path) or not os.path.isdir(path):
        os.unlink(path)
    else:
        shutil.rmtree(path)


def copy_regular_file(source: str, target: str, reporter: OperationReporter,
                      progress: dict[str, int]) -> None:
    details = os.stat(source, follow_symlinks=False)
    descriptor = -1
    created = False
    try:
        descriptor = os.open(target, os.O_WRONLY | os.O_CREAT | os.O_EXCL, details.st_mode & 0o777)
        created = True
        first_chunk = True
        with open(source, "rb") as input_stream, os.fdopen(descriptor, "wb") as output_stream:
            descriptor = -1
            while True:
                check_operation_cancelled()
                chunk = input_stream.read(COPY_CHUNK_SIZE)
                if not chunk:
                    break
                output_stream.write(chunk)
                progress["bytesDone"] += len(chunk)
                reporter.emit("copying", force=first_chunk, **progress)
                first_chunk = False
                check_operation_cancelled()
        shutil.copystat(source, target, follow_symlinks=False)
    except BaseException:
        if created:
            try:
                os.unlink(target)
            except OSError:
                pass
        raise
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def copy_scanned_source(source: str, target: str, entries: list[dict[str, Any]],
                        total_bytes: int, reporter: OperationReporter,
                        totals: dict[str, int]) -> None:
    progress = {
        "itemsDone": totals["itemsDone"],
        "itemsTotal": totals["itemsTotal"],
        "bytesDone": totals["bytesDone"],
        "bytesTotal": totals["bytesTotal"],
    }
    created = False
    try:
        root_kind = str(entries[0]["kind"])
        if root_kind == "directory":
            os.mkdir(target, os.stat(source, follow_symlinks=False).st_mode & 0o777)
        elif root_kind == "link":
            os.symlink(os.readlink(source), target)
        else:
            copy_regular_file(source, target, reporter, progress)
        created = True

        if root_kind == "directory":
            directories: list[tuple[str, str]] = [(source, target)]
            for entry in entries[1:]:
                check_operation_cancelled()
                destination = os.path.join(target, str(entry["relative"]))
                kind = str(entry["kind"])
                if kind == "directory":
                    os.mkdir(destination, os.stat(entry["path"], follow_symlinks=False).st_mode & 0o777)
                    directories.append((str(entry["path"]), destination))
                elif kind == "link":
                    os.symlink(os.readlink(entry["path"]), destination)
                    try:
                        shutil.copystat(entry["path"], destination, follow_symlinks=False)
                    except OSError:
                        pass
                else:
                    copy_regular_file(str(entry["path"]), destination, reporter, progress)
                progress["itemsDone"] += 1
                reporter.emit("copying", **progress)
            for original, destination in reversed(directories):
                shutil.copystat(original, destination, follow_symlinks=False)
        progress["itemsDone"] += 1
        totals.update(itemsDone=progress["itemsDone"], bytesDone=progress["bytesDone"])
        reporter.emit("copying", force=True, **progress)
    except BaseException:
        if created:
            try:
                remove_created_path(target)
            except OSError:
                pass
        raise


def trash_rows() -> list[dict[str, Any]]:
    code, output, error = run_bounded(["gio", "trash", "--list"], timeout=10)
    if code != 0:
        raise QuickfileError(error.strip() or "Could not read Trash", "trash-list-failed")
    rows: list[dict[str, Any]] = []
    for line in output.splitlines():
        if not line or "\t" not in line:
            continue
        uri, original = line.split("\t", 1)
        if not uri.startswith("trash:///"):
            continue
        rows.append({
            "uri": uri,
            "name": display_text(os.path.basename(original.rstrip(os.sep)) or original),
            "originalPath": display_text(original),
            "originalToken": encode_path(original),
        })
        if len(rows) >= DEFAULT_LIMIT:
            break
    return rows


def trash_list_command(_args: argparse.Namespace) -> dict[str, Any]:
    rows = trash_rows()
    return {"ok": True, "entries": rows, "count": len(rows),
            "truncated": len(rows) >= DEFAULT_LIMIT}


def require_trash_uri(uri: str) -> dict[str, Any]:
    if not uri or not uri.startswith("trash:///"):
        raise QuickfileError("Invalid Trash item", "invalid-trash-uri")
    for row in trash_rows():
        if row["uri"] == uri:
            return row
    raise QuickfileError("The Trash item no longer exists", "trash-item-missing")


def trash_uris_from_args(args: argparse.Namespace) -> list[str]:
    raw = getattr(args, "trash_uris_json", None)
    if raw:
        try:
            values = json.loads(raw)
        except json.JSONDecodeError as exc:
            raise QuickfileError("Invalid Trash item list", "invalid-trash-uri-list") from exc
        if not isinstance(values, list) or not values or len(values) > 500:
            raise QuickfileError("Select between 1 and 500 Trash items", "invalid-trash-uri-list")
        return [str(value) for value in values]
    uri = str(getattr(args, "trash_uri", "") or "")
    return [uri] if uri else []


def unique_transfer_target(source: str, destination_dir: str) -> str:
    source_is_dir = os.path.isdir(source) and not os.path.islink(source)
    target = os.path.join(destination_dir, os.path.basename(source))
    if not os.path.lexists(target):
        return target
    parent = os.path.dirname(target)
    name = os.path.basename(target)
    stem, suffix = (name, "") if source_is_dir else os.path.splitext(name)
    for number in range(1, 10001):
        marker = " (copy)" if number == 1 else f" (copy {number})"
        candidate = os.path.join(parent, f"{stem}{marker}{suffix}")
        if not os.path.lexists(candidate):
            return candidate
    raise QuickfileError("Could not choose a free destination name", "name-space-exhausted")


def conflict_row(source: str, target: str) -> dict[str, Any]:
    source_info = os.lstat(source)
    target_info = os.lstat(target)
    return {
        "sourcePath": display_text(source), "sourceToken": encode_path(source),
        "targetPath": display_text(target), "targetToken": encode_path(target),
        "name": display_text(os.path.basename(target)),
        "sourceKind": file_kind(source_info.st_mode),
        "targetKind": file_kind(target_info.st_mode),
        "canMerge": stat.S_ISDIR(source_info.st_mode) and stat.S_ISDIR(target_info.st_mode),
    }


def shallow_path_identity(path: str) -> dict[str, Any]:
    details = os.lstat(path)
    return {
        "device": details.st_dev, "inode": details.st_ino,
        "mode": stat.S_IFMT(details.st_mode), "size": details.st_size,
        "mtimeNs": details.st_mtime_ns,
    }


def trash_existing_for_replace(path: str, expected: dict[str, Any]) -> dict[str, Any]:
    try:
        matches_expected = shallow_path_identity(path) == expected
    except FileNotFoundError:
        matches_expected = False
    if not matches_expected:
        raise QuickfileError(
            "The destination changed while resolving the conflict", "conflict-target-changed"
        )
    before = {str(row["uri"]) for row in trash_rows()}
    code, _, error = run_bounded(["gio", "trash", "--", path], timeout=30)
    if code != 0:
        raise QuickfileError(error.strip() or "Could not preserve the replaced item in Trash",
                             "replace-backup-failed")
    for row in trash_rows():
        if (str(row["uri"]) not in before
                and normalized_path(str(row["originalPath"])) == normalized_path(path)):
            return row
    raise QuickfileError(
        "The previous item was moved to Trash but could not be tracked for Undo",
        "replace-backup-untracked",
    )


def restore_replaced_item(row: dict[str, Any]) -> None:
    uri = str(row.get("uri", ""))
    require_trash_uri(uri)
    code, _, error = run_bounded(["gio", "trash", "--restore", uri], timeout=30)
    if code != 0:
        raise QuickfileError(error.strip() or "Could not restore the replaced item",
                             "replace-restore-failed")


def copy_merge_entry(entry: dict[str, Any], target: str, reporter: OperationReporter,
                     totals: dict[str, int]) -> bool:
    kind = str(entry["kind"])
    if kind == "directory":
        try:
            os.mkdir(target, os.stat(entry["path"], follow_symlinks=False).st_mode & 0o777)
        except FileExistsError:
            return False
    elif kind == "link":
        try:
            os.symlink(os.readlink(entry["path"]), target)
        except FileExistsError:
            return False
    else:
        try:
            copy_regular_file(str(entry["path"]), target, reporter, totals)
        except FileExistsError:
            return False
    totals["itemsDone"] += 1
    reporter.emit("merging", force=True, **totals)
    return True


def execute_merge_plan(plan: dict[str, Any], action: str, totals: dict[str, int],
                       reporter: OperationReporter) -> dict[str, Any]:
    source = str(plan["source"])
    target_root = str(plan["target"])
    try:
        if (shallow_path_identity(target_root) != plan.get("conflictIdentity", {})
                or os.path.islink(target_root) or not os.path.isdir(target_root)):
            raise QuickfileError(
                "The destination changed while resolving the conflict",
                "conflict-target-changed",
            )
    except FileNotFoundError as exc:
        raise QuickfileError(
            "The destination changed while resolving the conflict",
            "conflict-target-changed",
        ) from exc
    resolved_target_root = os.path.realpath(target_root)
    entries = list(plan["entries"])
    created: list[dict[str, Any]] = []
    moved: list[dict[str, Any]] = []
    created_directories: list[dict[str, str]] = []
    source_directories = [
        {
            "source": str(entry["path"]),
            "target": target_root if not entry["relative"] else os.path.join(target_root, str(entry["relative"])),
        }
        for entry in entries if str(entry["kind"]) == "directory"
    ]
    skipped_directory_prefixes: list[str] = []
    try:
        totals["itemsDone"] += 1  # Existing merge root.
        for entry in entries[1:]:
            check_operation_cancelled()
            relative = str(entry["relative"])
            if any(relative == prefix or relative.startswith(prefix + os.sep)
                   for prefix in skipped_directory_prefixes):
                totals["itemsDone"] += 1
                totals["bytesTotal"] -= int(entry.get("size", 0))
                reporter.emit("merging", force=True, **totals)
                continue
            target = os.path.join(target_root, str(entry["relative"]))
            kind = str(entry["kind"])
            if os.path.lexists(target):
                # Merge is deliberately non-destructive: existing children win.
                if (kind == "directory"
                        and (not os.path.isdir(target) or os.path.islink(target))):
                    skipped_directory_prefixes.append(relative)
                totals["itemsDone"] += 1
                totals["bytesTotal"] -= int(entry.get("size", 0))
                reporter.emit("merging", force=True, **totals)
                continue
            if not path_within(os.path.realpath(os.path.dirname(target)), resolved_target_root):
                raise QuickfileError(
                    "A destination folder changed to an unsafe symlink during merge",
                    "unsafe-merge-target",
                )
            if not copy_merge_entry(entry, target, reporter, totals):
                totals["itemsDone"] += 1
                totals["bytesTotal"] -= int(entry.get("size", 0))
                reporter.emit("merging", force=True, **totals)
                continue
            created_item = {"path": target, "identity": {}}
            created.append(created_item)
            if kind == "directory":
                created_directories.append({"source": str(entry["path"]), "target": target})
            elif action == "move":
                remove_created_path(str(entry["path"]))
                moved.append({"source": str(entry["path"]), "target": target})
                rebase_saved_metadata(str(entry["path"]), target)

        if action == "move":
            for entry in reversed(entries):
                if str(entry["kind"]) != "directory":
                    continue
                try:
                    os.rmdir(str(entry["path"]))
                except OSError as exc:
                    if exc.errno not in {errno.ENOTEMPTY, errno.EEXIST}:
                        raise
    except BaseException:
        # Roll back only paths created by this merge. Existing destination
        # children are never touched.
        if action == "move":
            for directory in source_directories:
                os.makedirs(directory["source"], exist_ok=True)
            for item in reversed(moved):
                if os.path.lexists(item["target"]) and not os.path.lexists(item["source"]):
                    move_path_noreplace(item["target"], item["source"], reporter)
        for item in reversed(created):
            path = str(item["path"])
            if os.path.lexists(path):
                try:
                    remove_created_path(path)
                except OSError:
                    pass
        raise
    # Fingerprints are captured only after the complete merge so Undo can
    # validate all created paths before removing any of them.
    for item in created:
        if os.path.lexists(str(item["path"])):
            item["identity"] = shallow_path_identity(str(item["path"]))
    return {
        "source": source, "target": target_root, "identity": {}, "merged": True,
        "createdItems": created, "movedItems": moved,
        "createdDirectories": created_directories, "sourceDirectories": source_directories,
    }


def operation_result(action: str, message: str, **values: Any) -> dict[str, Any]:
    return {"event": "result", "ok": True, "action": action, "message": message, **values}


def rebase_saved_metadata(source: str, target: str) -> None:
    metadata = load_metadata_store()
    if rebase_metadata_records(metadata, source, target):
        save_metadata_store(metadata)


def move_path_noreplace(source: str, target: str, reporter: OperationReporter) -> None:
    try:
        rename_noreplace(source, target)
        rebase_saved_metadata(source, target)
        return
    except OSError as exc:
        if exc.errno != errno.EXDEV:
            raise
    entries, total_bytes = scan_copy_source(source, reporter)
    totals = {"itemsDone": 0, "itemsTotal": len(entries),
              "bytesDone": 0, "bytesTotal": total_bytes}
    copy_scanned_source(source, target, entries, total_bytes, reporter, totals)
    try:
        remove_created_path(source)
    except BaseException:
        # Keep both complete copies if removing the original fails; deleting the
        # destination here could discard the only good copy after a source error.
        raise
    rebase_saved_metadata(source, target)


def record_transfer_undo(action: str, completed: list[dict[str, Any]]) -> None:
    if not completed:
        return
    if any(item.get("merged") or item.get("replaced") for item in completed):
        record_operation(action, action, {
            "type": "transfer-batch", "action": action, "items": completed,
        })
        return
    if action == "move":
        inverse = {"type": "move-back", "items": [
            {"source": item["target"], "target": item["source"]} for item in completed
        ]}
    else:
        inverse = {"type": "delete-created", "items": [
            {"path": item["target"], "identity": item["identity"]} for item in completed
        ]}
    record_operation(action, action, inverse)


def execute_transfer_plan(plan: dict[str, Any], action: str, totals: dict[str, int],
                          reporter: OperationReporter) -> dict[str, Any] | None:
    check_operation_cancelled()
    if plan.get("unchanged"):
        return None
    source = str(plan["source"])
    policy = str(plan.get("conflictPolicy", "keep-both"))
    base_target = str(plan.get("target") or os.path.join(
        str(plan["destination"]), os.path.basename(source)
    ))
    if policy == "skip" and os.path.lexists(base_target):
        return {"source": source, "target": base_target, "skipped": True, "identity": {}}
    if policy == "merge" and plan.get("merge"):
        return execute_merge_plan(plan, action, totals, reporter)
    target = unique_transfer_target(source, str(plan["destination"])) \
        if policy == "keep-both" else base_target
    replaced: dict[str, Any] | None = None
    if policy == "replace" and os.path.lexists(target):
        replaced = trash_existing_for_replace(target, dict(plan["conflictIdentity"]))
        plan["_replaced"] = replaced
    if plan.get("atomicMove"):
        attempts = 100 if policy == "keep-both" else 1
        for _attempt in range(attempts):
            try:
                rename_noreplace(source, target)
                break
            except QuickfileError as exc:
                if exc.code != "name-conflict" or policy != "keep-both":
                    raise
                target = unique_transfer_target(source, str(plan["destination"]))
        else:
            raise QuickfileError("Destination names keep changing", "name-conflict")
        totals["itemsDone"] += 1
        reporter.emit("moving", force=True, **totals)
    else:
        attempts = 100 if policy == "keep-both" else 1
        for _attempt in range(attempts):
            try:
                copy_scanned_source(source, target, plan["entries"], plan["bytes"], reporter, totals)
                break
            except FileExistsError:
                if policy != "keep-both":
                    raise QuickfileError(
                        "The destination changed while resolving the conflict",
                        "conflict-target-changed",
                    )
                target = unique_transfer_target(source, str(plan["destination"]))
        else:
            raise QuickfileError("Destination names keep changing", "name-conflict")
        if action == "move":
            remove_created_path(source)
    if action == "move":
        identity: dict[str, Any] = {}
    else:
        try:
            identity = path_identity(target)
        except BaseException:
            # The undo fingerprint is part of a safe copy transaction. Do not
            # leave an untracked result if fingerprinting is cancelled/fails.
            remove_created_path(target)
            raise
    completed = {"source": source, "target": target, "identity": identity}
    if replaced is not None:
        completed["replaced"] = replaced
    return completed


def run_undo(reporter: OperationReporter) -> dict[str, Any]:
    operations = load_operation_history()
    if not operations:
        raise QuickfileError("There is nothing to undo", "nothing-to-undo")
    record = operations[-1]
    inverse = record.get("inverse", {})
    inverse_type = str(inverse.get("type", "")) if isinstance(inverse, dict) else ""
    items = inverse.get("items", []) if isinstance(inverse, dict) else []
    if not isinstance(items, list):
        raise QuickfileError("The undo record is invalid", "history-invalid")
    reporter.emit("undoing", force=True, itemsDone=0, itemsTotal=len(items),
                  bytesDone=0, bytesTotal=0)
    if inverse_type == "transfer-batch":
        transfer_action = str(inverse.get("action", ""))
        for item in items:
            if not isinstance(item, dict):
                raise QuickfileError("The undo record is invalid", "history-invalid")
            if item.get("merged"):
                for created in item.get("createdItems", []):
                    path = str(created.get("path", ""))
                    if (not os.path.lexists(path)
                            or shallow_path_identity(path) != created.get("identity", {})):
                        raise QuickfileError(
                            "Undo stopped because a merged item was changed or replaced",
                            "undo-target-changed",
                        )
            elif transfer_action != "move" and not identity_matches(
                    str(item.get("target", "")), item.get("identity", {})):
                raise QuickfileError(
                    "Undo stopped because a created item was changed or replaced",
                    "undo-target-changed",
                )
        for index, item in enumerate(reversed(items), 1):
            check_operation_cancelled()
            if item.get("merged"):
                created = list(item.get("createdItems", []))
                if transfer_action == "move":
                    directories = list(item.get("sourceDirectories", []))
                    for directory in directories:
                        os.makedirs(str(directory["source"]), exist_ok=True)
                    for moved in reversed(list(item.get("movedItems", []))):
                        move_path_noreplace(
                            str(moved["target"]), str(moved["source"]), reporter
                        )
                for created_item in reversed(created):
                    path = str(created_item["path"])
                    if not os.path.lexists(path):
                        continue
                    if os.path.isdir(path) and not os.path.islink(path):
                        try:
                            os.rmdir(path)
                        except OSError as exc:
                            if exc.errno not in {errno.ENOTEMPTY, errno.EEXIST}:
                                raise
                    else:
                        os.unlink(path)
            elif transfer_action == "move":
                move_path_noreplace(str(item["target"]), str(item["source"]), reporter)
            else:
                remove_created_path(str(item["target"]))
            if isinstance(item.get("replaced"), dict):
                restore_replaced_item(item["replaced"])
            reporter.emit("undoing", force=True, itemsDone=index, itemsTotal=len(items),
                          bytesDone=0, bytesTotal=0)
    elif inverse_type == "delete-created":
        for item in items:
            if not isinstance(item, dict) or not identity_matches(str(item.get("path", "")), item.get("identity", {})):
                raise QuickfileError(
                    "Undo stopped because a created item was changed or replaced",
                    "undo-target-changed",
                )
        for index, item in enumerate(reversed(items), 1):
            check_operation_cancelled()
            remove_created_path(str(item["path"]))
            reporter.emit("undoing", force=True, itemsDone=index, itemsTotal=len(items),
                          bytesDone=0, bytesTotal=0)
    elif inverse_type in {"rename", "move-back"}:
        for index, item in enumerate(reversed(items), 1):
            check_operation_cancelled()
            source = str(item["source"])
            target = str(item["target"])
            if inverse_type == "move-back":
                move_path_noreplace(source, target, reporter)
            else:
                rename_noreplace(source, target)
                rebase_saved_metadata(source, target)
            reporter.emit("undoing", force=True, itemsDone=index, itemsTotal=len(items),
                          bytesDone=0, bytesTotal=0)
    elif inverse_type == "restore-trash":
        for index, item in enumerate(items, 1):
            check_operation_cancelled()
            uri = str(item.get("uri", ""))
            require_trash_uri(uri)
            code, _, error = run_bounded(["gio", "trash", "--restore", uri], timeout=30)
            if code != 0:
                raise QuickfileError(error.strip() or "Could not restore item", "trash-restore-failed")
            reporter.emit("undoing", force=True, itemsDone=index, itemsTotal=len(items),
                          bytesDone=0, bytesTotal=0)
    elif inverse_type == "trash-paths":
        for index, item in enumerate(items, 1):
            check_operation_cancelled()
            path = str(item.get("path", ""))
            code, _, error = run_bounded(["gio", "trash", "--", path], timeout=30)
            if code != 0:
                raise QuickfileError(error.strip() or "Could not move item to Trash", "trash-failed")
            reporter.emit("undoing", force=True, itemsDone=index, itemsTotal=len(items),
                          bytesDone=0, bytesTotal=0)
    else:
        raise QuickfileError("This operation cannot be undone", "undo-unsupported")
    operations.pop()
    save_operation_history(operations)
    return operation_result("undo", f'Undid {record.get("label", "operation")}', undoAvailable=bool(operations))


def operation_command(args: argparse.Namespace, callback: Any = json_print) -> dict[str, Any]:
    global _operation_cancelled
    _operation_cancelled = False
    reporter = OperationReporter(callback)
    action = str(args.action)

    if action == "undo":
        return run_undo(reporter)

    if action in {"restore", "trash-delete"}:
        uris = trash_uris_from_args(args)
        if not uris:
            raise QuickfileError("Select a Trash item", "missing-trash-item")
        completed: list[dict[str, Any]] = []
        for index, uri in enumerate(uris, 1):
            check_operation_cancelled()
            row = require_trash_uri(uri)
            if action == "restore":
                code, _, error = run_bounded(["gio", "trash", "--restore", uri], timeout=30)
                failure = "Could not restore item"
            else:
                code, _, error = run_bounded(["gio", "remove", uri], timeout=30)
                failure = "Could not permanently delete item"
            if code != 0:
                if completed:
                    discard_history_referencing_trash({str(row["uri"]) for row in completed})
                    if action == "restore":
                        record_operation("restore", "restore from Trash", {
                            "type": "trash-paths",
                            "items": [{"path": row["originalPath"]} for row in completed],
                        })
                raise QuickfileError(error.strip() or failure,
                                     "trash-restore-failed" if action == "restore" else "trash-delete-failed")
            completed.append(row)
            reporter.emit("restoring" if action == "restore" else "deleting", force=True,
                          itemsDone=index, itemsTotal=len(uris), bytesDone=0, bytesTotal=0)
        if action == "restore":
            discard_history_referencing_trash({str(row["uri"]) for row in completed})
            record_operation("restore", "restore from Trash", {
                "type": "trash-paths",
                "items": [{"path": row["originalPath"]} for row in completed],
            })
        else:
            discard_history_referencing_trash({str(row["uri"]) for row in completed})
        return operation_result(action, "Restored from Trash" if action == "restore"
                                else "Permanently deleted")

    paths = action_paths_from_args(args)
    if action == "rename":
        if len(paths) != 1:
            raise QuickfileError("Rename supports one item", "single-item-action")
        source = paths[0]
        target = os.path.join(os.path.dirname(source), require_name(args.name or ""))
        changed = rename_noreplace(source, target)
        if changed:
            record_operation("rename", "rename", {
                "type": "rename", "items": [{"source": target, "target": source}],
            })
            rebase_saved_metadata(source, target)
        return operation_result(action, "Renamed" if changed else "Name unchanged",
                                path=display_text(target), token=encode_path(target), changed=changed)

    if action == "trash":
        before = {row["uri"] for row in trash_rows()}
        trashed: list[dict[str, Any]] = []
        for index, path in enumerate(paths, 1):
            check_operation_cancelled()
            code, _, error = run_bounded(["gio", "trash", "--", path], timeout=30)
            if code != 0:
                if trashed:
                    record_operation("trash", "move to Trash", {
                        "type": "restore-trash",
                        "items": [{"uri": row["uri"], "path": row["originalPath"]}
                                  for row in trashed],
                    })
                raise QuickfileError(error.strip() or "Could not move item to Trash", "trash-failed")
            current = trash_rows()
            match = next((row for row in current
                          if row["uri"] not in before
                          and normalized_path(row["originalPath"]) == normalized_path(path)), None)
            if match:
                trashed.append(match)
                before.add(match["uri"])
            reporter.emit("trashing", force=True, itemsDone=index, itemsTotal=len(paths),
                          bytesDone=0, bytesTotal=0)
        if trashed:
            record_operation("trash", "move to Trash", {
                "type": "restore-trash",
                "items": [{"uri": row["uri"], "path": row["originalPath"]} for row in trashed],
            })
        return operation_result(action, "Moved to Trash" if len(paths) == 1
                                else f"Moved {len(paths)} items to Trash")

    if action not in {"copy", "move", "duplicate"}:
        raise QuickfileError(f"Unsupported operation: {action}", "unsupported-action")
    destination = destination_from_args(args) if action != "duplicate" else ""
    if destination and not os.path.isdir(destination):
        raise QuickfileError("Destination is not a directory", "not-a-directory")
    policy = str(getattr(args, "conflict_policy", "keep-both") or "keep-both")
    if policy not in CONFLICT_POLICIES:
        raise QuickfileError("Invalid conflict policy", "invalid-conflict-policy")
    if action == "duplicate" and policy == "ask":
        policy = "keep-both"
    for source in paths:
        if not os.path.lexists(source):
            raise QuickfileError(
                f'“{display_text(os.path.basename(source))}” no longer exists', "missing-path"
            )
    for source in paths:
        if not os.path.isdir(source) or os.path.islink(source):
            continue
        prefix = source.rstrip(os.sep) + os.sep
        if any(other != source and other.startswith(prefix) for other in paths):
            raise QuickfileError(
                "A selection cannot contain both a folder and its child", "nested-selection"
            )

    conflicts: list[dict[str, Any]] = []
    for source in paths:
        destination_dir = os.path.dirname(source) if action == "duplicate" else destination
        if action == "move" and os.path.dirname(source) == destination_dir:
            continue
        target = os.path.join(destination_dir, os.path.basename(source))
        if os.path.lexists(target):
            conflicts.append(conflict_row(source, target))
    if policy == "ask" and conflicts:
        raise OperationConflict(conflicts)
    if policy == "merge":
        invalid = [row for row in conflicts if not row["canMerge"]]
        if invalid:
            raise OperationConflict(invalid)
    if policy == "replace":
        for row in conflicts:
            if normalized_path(str(row["sourcePath"])) == normalized_path(str(row["targetPath"])):
                raise QuickfileError(
                    "An item cannot replace itself; use Keep Both or Skip",
                    "self-replace",
                )

    plans: list[dict[str, Any]] = []
    total_items = 0
    total_bytes = 0
    journal_estimate = 0
    late_conflicts: list[dict[str, Any]] = []
    for source in paths:
        destination_dir = os.path.dirname(source) if action == "duplicate" else destination
        if action == "move" and os.path.dirname(source) == destination_dir:
            plans.append({"source": source, "destination": destination_dir, "unchanged": True})
            continue
        target = os.path.join(destination_dir, os.path.basename(source))
        has_conflict = os.path.lexists(target)
        if policy == "ask" and has_conflict:
            late_conflicts.append(conflict_row(source, target))
        if os.path.isdir(source) and not os.path.islink(source):
            try:
                common = os.path.commonpath((os.path.realpath(source), os.path.realpath(destination_dir)))
            except ValueError:
                common = ""
            if common == os.path.realpath(source):
                raise QuickfileError("A folder cannot be copied or moved into itself", "recursive-transfer")
        merge = policy == "merge" and has_conflict
        journal_estimate += 4 * (
            len(os.fsencode(source)) + len(os.fsencode(target))
        ) + 1024
        same_device_move = (
            action == "move" and not merge
            and os.stat(source, follow_symlinks=False).st_dev == os.stat(destination_dir).st_dev
        )
        if policy == "skip" and has_conflict:
            entries, bytes_count = [], 0
            same_device_move = False
        elif same_device_move:
            entries, bytes_count = [], 0
        else:
            entries, bytes_count = scan_copy_source(source, reporter)
            total_items += len(entries)
            total_bytes += bytes_count
            if total_items > OPERATION_ENTRY_LIMIT:
                raise QuickfileError(
                    f"Selection contains more than {OPERATION_ENTRY_LIMIT:,} items",
                    "copy-entry-limit",
                )
            if merge:
                journal_estimate += sum(
                    4 * len(os.fsencode(str(entry["relative"]))) + 512
                    for entry in entries
                )
        if journal_estimate > OPERATION_JOURNAL_BUDGET:
            raise QuickfileError(
                "This operation is too large to keep a safe Undo journal; transfer fewer items",
                "operation-journal-limit",
            )
        plans.append({"source": source, "destination": destination_dir,
                      "target": target, "conflictPolicy": policy, "merge": merge,
                      "conflictIdentity": shallow_path_identity(target) if has_conflict else {},
                      "entries": entries, "bytes": bytes_count,
                      "atomicMove": same_device_move, "unchanged": False})

    if late_conflicts:
        raise OperationConflict(late_conflicts)

    totals = {"itemsDone": 0, "itemsTotal": total_items + sum(
        1 for plan in plans if plan.get("atomicMove") is True),
        "bytesDone": 0, "bytesTotal": total_bytes}
    completed: list[dict[str, Any]] = []
    skipped: list[dict[str, Any]] = []
    for plan in plans:
        try:
            result = execute_transfer_plan(plan, action, totals, reporter)
        except BaseException:
            replaced = plan.get("_replaced")
            target = str(plan.get("target", ""))
            if isinstance(replaced, dict) and target and not os.path.lexists(target):
                restore_replaced_item(replaced)
            # A later item can fail after earlier batch items completed. Keep
            # those completed changes undoable instead of orphaning them.
            record_transfer_undo(action, completed)
            raise
        if result is not None:
            if result.get("skipped"):
                skipped.append(result)
                continue
            if result.get("merged") and not result.get("createdItems"):
                skipped.append(result)
                continue
            completed.append(result)
            if action == "move" and not result.get("merged"):
                try:
                    rebase_saved_metadata(str(result["source"]), str(result["target"]))
                except BaseException:
                    record_transfer_undo(action, completed)
                    raise

    record_transfer_undo(action, completed)
    results = [{"path": display_text(item["target"]), "token": encode_path(item["target"]),
                "status": "merged" if item.get("merged") else "completed"}
               for item in completed]
    results.extend({"path": display_text(item["target"]), "token": encode_path(item["target"]),
                    "status": "skipped"} for item in skipped)
    changed_count = len(completed)
    message = (f"Skipped {len(skipped)} existing item" + ("s" if len(skipped) != 1 else "")) \
        if not changed_count and skipped else "Already in this folder" if not changed_count else (
        "Moved" if action == "move" else "Duplicated" if action == "duplicate" else "Copied"
    )
    if changed_count > 1:
        message += f" {changed_count} items"
    return operation_result(action, message, changed=changed_count > 0, results=results,
                            skippedCount=len(skipped), conflictPolicyApplied=policy,
                            path=results[0]["path"] if results else "",
                            token=results[0]["token"] if results else "")


def keep_both_path(path: str, *, directory: bool) -> str:
    if not os.path.lexists(path):
        return path
    parent = os.path.dirname(path)
    name = os.path.basename(path)
    if directory:
        stem, suffix = name, ""
    else:
        stem, suffix = os.path.splitext(name)
    candidate = os.path.join(parent, f"{stem} (copy){suffix}")
    number = 2
    while os.path.lexists(candidate) and number <= 10000:
        candidate = os.path.join(parent, f"{stem} (copy {number}){suffix}")
        number += 1
    if os.path.lexists(candidate):
        raise QuickfileError("Could not choose a free destination name", "name-space-exhausted")
    return candidate


def transfer_path(source: str, destination_dir: str, *, move: bool) -> tuple[str, bool]:
    global _operation_cancelled
    _operation_cancelled = False
    if not os.path.isdir(destination_dir):
        raise QuickfileError("Destination is not a directory", "not-a-directory")
    source = normalized_path(source)
    destination_dir = normalized_path(destination_dir)
    if move and os.path.dirname(source) == destination_dir:
        return source, False

    source_is_link = os.path.islink(source)
    source_is_dir = os.path.isdir(source) and not source_is_link
    if source_is_dir:
        try:
            common = os.path.commonpath((os.path.realpath(source), os.path.realpath(destination_dir)))
        except ValueError:
            common = ""
        if common == os.path.realpath(source):
            raise QuickfileError("A folder cannot be copied or moved into itself", "recursive-transfer")

    target = unique_transfer_target(source, destination_dir)
    if move:
        try:
            rename_noreplace(source, target)
            return target, True
        except OSError as exc:
            if exc.errno != errno.EXDEV:
                raise
    reporter = OperationReporter(lambda _event: None)
    entries, total_bytes = scan_copy_source(source, reporter)
    totals = {"itemsDone": 0, "itemsTotal": len(entries),
              "bytesDone": 0, "bytesTotal": total_bytes}
    copy_scanned_source(source, target, entries, total_bytes, reporter, totals)
    if move:
        remove_created_path(source)
    return target, True


def action_command(args: argparse.Namespace) -> dict[str, Any]:
    action = args.action
    paths = action_paths_from_args(args)
    path = paths[0]
    if len(paths) > 1 and action not in {"copy", "move", "trash", "duplicate"}:
        raise QuickfileError(f"{action} only supports one item", "single-item-action")
    if action == "open":
        process = subprocess.Popen(
            ["gio", "open", path],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return {"ok": True, "action": action, "pid": process.pid}
    if action == "reveal":
        target = path if os.path.isdir(path) else os.path.dirname(path)
        process = subprocess.Popen(
            ["gio", "open", target],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return {"ok": True, "action": action, "pid": process.pid}
    if action == "preview":
        if os.path.isdir(path):
            raise QuickfileError("Select a file to preview", "preview-directory")
        if not os.path.exists(path):
            raise QuickfileError("The selected file no longer exists", "missing-path")
        executable = shutil.which("sushi")
        if not executable:
            raise QuickfileError("GNOME Sushi is not installed", "preview-unavailable")
        process = subprocess.Popen(
            [executable, path],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        return {
            "ok": True,
            "action": action,
            "message": "QuickView opened",
            "pid": process.pid,
        }
    if action == "copy-path":
        executable = shutil.which("wl-copy")
        if not executable:
            raise QuickfileError("wl-copy is not installed", "clipboard-unavailable")
        try:
            result = subprocess.run(
                [
                    executable,
                    "--type",
                    "text/plain;charset=utf-8",
                    display_text(path),
                ],
                stdout=subprocess.DEVNULL,
                # wl-copy forks a background clipboard owner. A PIPE here is
                # inherited by that child, so subprocess.run() waits forever
                # for EOF even though the launcher has already exited.
                stderr=subprocess.DEVNULL,
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.TimeoutExpired) as exc:
            raise QuickfileError(str(exc), "clipboard-failed") from exc
        if result.returncode != 0:
            raise QuickfileError("Could not copy the path", "clipboard-failed")
        return {"ok": True, "action": action, "message": "Path copied"}
    if action == "trash":
        code, _, error = run_bounded(["gio", "trash", "--", *paths], timeout=30)
        if code != 0:
            raise QuickfileError(error.strip() or "Could not move item to Trash", "trash-failed")
        return {
            "ok": True,
            "action": action,
            "message": "Moved to Trash" if len(paths) == 1 else f"Moved {len(paths)} items to Trash",
        }
    if action in {"mkdir", "touch"}:
        if not os.path.isdir(path):
            raise QuickfileError("Parent is not a directory", "not-a-directory")
        target = os.path.join(path, require_name(args.name or ""))
        if action == "mkdir":
            os.mkdir(target)
        else:
            fd = os.open(target, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o644)
            os.close(fd)
        return {"ok": True, "action": action, "path": display_text(target), "token": encode_path(target)}
    if action == "rename":
        target = os.path.join(os.path.dirname(path), require_name(args.name or ""))
        changed = rename_noreplace(path, target)
        metadata = load_metadata_store()
        if changed and rebase_metadata_records(metadata, path, target):
            save_metadata_store(metadata)
        return {"ok": True, "action": action, "path": display_text(target),
                "token": encode_path(target), "changed": changed}
    if action in {"copy", "move"}:
        destination = destination_from_args(args)
        results: list[dict[str, Any]] = []
        metadata = load_metadata_store() if action == "move" else None
        for source in paths:
            target, changed = transfer_path(source, destination, move=action == "move")
            results.append({
                "sourceToken": encode_path(source),
                "path": display_text(target),
                "token": encode_path(target),
                "changed": changed,
            })
            if changed and metadata is not None and rebase_metadata_records(metadata, source, target):
                # Persist after every move so an unrelated later failure cannot
                # orphan notes, colors, or favorites already moved on disk.
                save_metadata_store(metadata)
        changed_count = sum(1 for result in results if result["changed"])
        if changed_count == 0:
            message = "Already in this folder"
        elif len(results) == 1:
            message = "Moved" if action == "move" else "Copied"
        else:
            message = f"{'Moved' if action == 'move' else 'Copied'} {changed_count} items"
        return {
            "ok": True,
            "action": action,
            "changed": changed_count > 0,
            "message": message,
            "path": results[0]["path"],
            "token": results[0]["token"],
            "results": results,
        }
    if action == "duplicate":
        results = []
        for source in paths:
            target, _ = transfer_path(source, os.path.dirname(source), move=False)
            results.append({"path": display_text(target), "token": encode_path(target)})
        return {
            "ok": True,
            "action": action,
            "message": "Duplicated" if len(results) == 1 else f"Duplicated {len(results)} items",
            "path": results[0]["path"],
            "token": results[0]["token"],
            "results": results,
        }
    raise QuickfileError(f"Unsupported action: {action}", "unsupported-action")


def add_path_arguments(parser: argparse.ArgumentParser) -> None:
    group = parser.add_mutually_exclusive_group()
    group.add_argument("--path")
    group.add_argument("--path-token")


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(prog="quickfile", description=__doc__)
    root.add_argument("--version", action="version", version=VERSION)
    subcommands = root.add_subparsers(dest="command", required=True)

    tree = subcommands.add_parser("tree", help="Return a bounded, expanded filesystem tree")
    add_path_arguments(tree)
    tree.add_argument("--expanded", action="append", default=[])
    tree.add_argument("--show-hidden", action="store_true")
    tree.add_argument("--no-git", action="store_true")
    tree.add_argument("--max-depth", type=int, default=12)
    tree.add_argument("--limit", type=int, default=DEFAULT_LIMIT)

    search = subcommands.add_parser("search", help="Recursively search below a root")
    add_path_arguments(search)
    search.add_argument("--query", required=True)
    search.add_argument("--mode", choices=("contains", "exact", "prefix", "suffix", "regex", "fuzzy"), default="fuzzy")
    search.add_argument("--case-sensitive", action="store_true")
    search.add_argument("--show-hidden", action="store_true")
    search.add_argument("--no-git", action="store_true")
    search.add_argument("--limit", type=int, default=DEFAULT_LIMIT)
    search.add_argument("--scan-limit", type=int, default=100000)
    search.add_argument("--timeout", type=float, default=5.0)
    search.add_argument("--content-file-limit", type=int, default=DEFAULT_CONTENT_FILE_LIMIT)
    search.add_argument("--content-byte-limit", type=int, default=DEFAULT_CONTENT_BYTE_LIMIT)

    quick_nav = subcommands.add_parser("quick-nav", help="Return bounded navigation locations")
    add_path_arguments(quick_nav)
    quick_nav.add_argument("--record", action="store_true")
    quick_nav.add_argument("--no-zoxide", action="store_true")
    quick_nav.add_argument("--limit", type=int, default=QUICK_NAV_LIMIT)

    inline_preview = subcommands.add_parser("preview", help="Return a bounded inline preview")
    add_path_arguments(inline_preview)
    inline_preview.add_argument("--byte-limit", type=int, default=PREVIEW_READ_LIMIT)

    properties = subcommands.add_parser("properties", help="Return filesystem metadata")
    add_path_arguments(properties)

    subcommands.add_parser(
        "volumes", help="List external and removable storage volumes"
    )

    volume_action = subcommands.add_parser(
        "volume-action", help="Mount or unmount one discovered external volume"
    )
    volume_action.add_argument("action", choices=("mount", "unmount"))
    volume_action.add_argument("--device", required=True)

    knowledge = subcommands.add_parser(
        "knowledge", help="Index agent instruction files that apply to a directory"
    )
    add_path_arguments(knowledge)
    knowledge.add_argument("--limit", type=int, default=KNOWLEDGE_LIMIT)

    sessions = subcommands.add_parser(
        "sessions", help="List active terminal-backed AI sessions for a directory"
    )
    add_path_arguments(sessions)
    sessions.add_argument("--limit", type=int, default=ACTIVE_SESSION_LIMIT)

    settings = subcommands.add_parser(
        "settings", help="Read or update private QuickFile preferences"
    )
    settings.add_argument("--active-sessions", choices=("true", "false"))
    settings.add_argument("--inspector-tab", choices=INSPECTOR_TAB_ORDER)
    settings.add_argument("--module-layout-json")

    knowledge_links = subcommands.add_parser(
        "knowledge-links",
        help="Preview or create non-overwriting agent configuration symlinks",
    )
    source_group = knowledge_links.add_mutually_exclusive_group(required=True)
    source_group.add_argument("--source")
    source_group.add_argument("--source-token")
    root_group = knowledge_links.add_mutually_exclusive_group(required=True)
    root_group.add_argument("--root")
    root_group.add_argument("--root-token")
    knowledge_links.add_argument("--apply", action="store_true")

    metadata = subcommands.add_parser(
        "metadata", help="Save Quickfile color, note, favorite, and Knowledge state"
    )
    add_path_arguments(metadata)
    metadata.add_argument("--color")
    metadata.add_argument("--note")
    metadata.add_argument("--starred", choices=("true", "false"))
    metadata.add_argument("--knowledge", choices=("true", "false"))
    metadata.add_argument("--agents-json")

    action = subcommands.add_parser("action", help="Perform one explicit filesystem action")
    action.add_argument("action", choices=(
        "open", "reveal", "preview", "copy-path", "trash", "mkdir", "touch", "rename",
        "copy", "move", "duplicate",
    ))
    add_path_arguments(action)
    action.add_argument("--path-tokens-json")
    action.add_argument("--source-uris-json")
    action.add_argument("--name")
    destination = action.add_mutually_exclusive_group()
    destination.add_argument("--destination")
    destination.add_argument("--destination-token")

    operation = subcommands.add_parser(
        "operation", help="Run a cancellable filesystem operation with NDJSON progress"
    )
    operation.add_argument("action", choices=(
        "rename", "copy", "move", "duplicate", "trash", "restore", "trash-delete", "undo",
    ))
    add_path_arguments(operation)
    operation.add_argument("--path-tokens-json")
    operation.add_argument("--source-uris-json")
    operation.add_argument("--name")
    operation_destination = operation.add_mutually_exclusive_group()
    operation_destination.add_argument("--destination")
    operation_destination.add_argument("--destination-token")
    operation.add_argument("--trash-uri")
    operation.add_argument("--trash-uris-json")
    operation.add_argument("--conflict-policy", choices=CONFLICT_POLICIES, default="ask")

    subcommands.add_parser("trash-list", help="List bounded Trash entries")
    subcommands.add_parser("history", help="Return the latest undoable operation")
    return root


def main(argv: Iterable[str] | None = None) -> int:
    args = parser().parse_args(list(argv) if argv is not None else None)
    if args.command == "operation":
        signal.signal(signal.SIGTERM, request_operation_cancel)
        signal.signal(signal.SIGINT, request_operation_cancel)
    try:
        if args.command == "tree":
            result = tree_command(args)
        elif args.command == "search":
            result = search_command(args)
        elif args.command == "quick-nav":
            result = quick_nav_command(args)
        elif args.command == "preview":
            result = inline_preview_command(args)
        elif args.command == "properties":
            result = properties_command(args)
        elif args.command == "volumes":
            result = volumes_command(args)
        elif args.command == "volume-action":
            result = volume_action_command(args)
        elif args.command == "knowledge":
            result = knowledge_command(args)
        elif args.command == "sessions":
            result = sessions_command(args)
        elif args.command == "settings":
            result = settings_command(args)
        elif args.command == "knowledge-links":
            result = knowledge_links_command(args)
        elif args.command == "metadata":
            result = metadata_command(args)
        elif args.command == "operation":
            result = operation_command(args)
        elif args.command == "trash-list":
            result = trash_list_command(args)
        elif args.command == "history":
            result = history_command(args)
        else:
            result = action_command(args)
        json_print(result)
        return 0
    except QuickfileError as exc:
        payload = {"ok": False, "error": str(exc), "code": exc.code}
        if isinstance(exc, OperationConflict):
            payload["conflicts"] = exc.conflicts
            payload["conflictPolicyOptions"] = list(CONFLICT_POLICIES[1:])
        if args.command == "operation":
            payload["event"] = "result"
        json_print(payload)
        return 130 if isinstance(exc, OperationCancelled) else 2
    except FileExistsError as exc:
        json_print({"ok": False, "error": str(exc), "code": "already-exists"})
        return 3
    except PermissionError as exc:
        json_print({"ok": False, "error": str(exc), "code": "permission-denied"})
        return 4
    except OSError as exc:
        json_print({"ok": False, "error": str(exc), "code": "filesystem-error"})
        return 5


if __name__ == "__main__":
    raise SystemExit(main())
