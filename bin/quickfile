import mimetypes
import os
import pwd
import re
import selectors
import shlex
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import uuid
from pathlib import Path
from typing import Any, Iterable


VERSION = "0.11.3"
DEFAULT_LIMIT = 2000
COMMAND_TIMEOUT = 3
DEFAULT_CONTENT_FILE_LIMIT = 1024 * 1024
DEFAULT_CONTENT_BYTE_LIMIT = 8 * 1024 * 1024
CONTENT_LINE_LIMIT = 4096
CONTENT_SNIPPET_LIMIT = 160
METADATA_SIZE_LIMIT = 8 * 1024 * 1024
NOTE_LENGTH_LIMIT = 16384
FAVORITES_LIMIT = 200
COLOR_KEYS = {"red", "yellow", "orange", "green", "cyan", "blue", "magenta", "brown"}
KNOWLEDGE_LIMIT = 128
WATCH_PATH_LIMIT = 4096
OPERATION_ENTRY_LIMIT = 250000
OPERATION_DEPTH_LIMIT = 128
OPERATION_HISTORY_LIMIT = 50
OPERATION_HISTORY_SIZE_LIMIT = 2 * 1024 * 1024
OPERATION_JOURNAL_BUDGET = 1024 * 1024
COPY_CHUNK_SIZE = 1024 * 1024
QUICK_NAV_LIMIT = 200
QUICK_NAV_SIZE_LIMIT = 256 * 1024
QUICK_NAV_COMMAND_LIMIT = 512 * 1024
SETTINGS_SIZE_LIMIT = 64 * 1024
PREVIEW_READ_LIMIT = 256 * 1024
PREVIEW_TEXT_LIMIT = 65536
PREVIEW_DIRECTORY_LIMIT = 64
RG_OUTPUT_LIMIT = 4 * 1024 * 1024
CONFLICT_POLICIES = ("ask", "keep-both", "skip", "merge", "replace")
KNOWLEDGE_AGENT_ORDER = (
    "codex", "claude", "gemini", "cursor", "copilot", "windsurf",
)
KNOWLEDGE_AGENT_KEYS = set(KNOWLEDGE_AGENT_ORDER)
MODULE_ORDER = ("sessions", "devices", "favorites", "knowledge")
MODULE_KEYS = set(MODULE_ORDER)
INSPECTOR_TAB_ORDER = ("properties", "notes", "git")
INSPECTOR_TAB_KEYS = set(INSPECTOR_TAB_ORDER)
