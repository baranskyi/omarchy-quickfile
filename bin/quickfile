MODULE_KEYS = set(MODULE_ORDER)
INSPECTOR_TAB_ORDER = ("properties", "notes", "git")
INSPECTOR_TAB_KEYS = set(INSPECTOR_TAB_ORDER)
# Listing orders offered in the panel, in the order the sort control cycles
# them. Directories stay above files in every one of them.
SORT_ORDER = ("name", "name-desc", "modified", "modified-asc", "size", "type")
SORT_ORDERS = set(SORT_ORDER)
# How the panel renders a row's timestamp, in the order the chip cycles them.
# Purely a presentation choice: the listing always carries the same mtime.
DATE_FORMAT = ("full", "adaptive", "smart", "relative", "off")
DATE_FORMATS = set(DATE_FORMAT)
