#!/usr/bin/env python3
"""Install and run QuickFile's optional local Laya smart-search helper."""

from __future__ import annotations

import argparse
import contextlib
import json
import os
import selectors
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from pathlib import Path
from typing import Any

from quickfile_smart import (
    SMART_PLAN_LIMIT,
    SMART_QUERY_LIMIT,
    fallback_plan,
    merge_laya_answers,
    questions,
)


LAYA_VERSION = "0.3.5"
MODEL_REPO = "convaiinnovations/laya"
MODEL_SUBFOLDER = "multilingual"
MODEL_REVISION = "1c5edc17a7acd8701df6fc341c0d179f1c62c982"
# PyPI's Linux torch wheel pulls several gigabytes of CUDA libraries. The
# classifier answers three short questions per query, so the CPU build is fast
# enough and never wakes a discrete GPU for a file-manager search.
TORCH_INDEX_URL = "https://download.pytorch.org/whl/cpu"
INFERENCE_DEVICE = "cpu"
INFERENCE_THREADS = 4
INSTALL_MARKER_VERSION = 1
MESSAGE_LIMIT = 64 * 1024
INSTALL_TIMEOUT = 30 * 60
PROTOCOL_STREAM = sys.stdout
PROTOCOL_LOCK = threading.Lock()
ACTIVE_CHILD: subprocess.Popen[Any] | None = None


def stop_child_group(process: subprocess.Popen[Any]) -> None:
    """Stop an installer subprocess and any descendants in its private group."""
    try:
        os.killpg(process.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    except OSError:
        try:
            process.kill()
        except OSError:
            pass


def handle_termination(signum: int, _frame: Any) -> None:
    child = ACTIVE_CHILD
    if child is not None and child.poll() is None:
        stop_child_group(child)
    raise SystemExit(128 + signum)


def semantic_root() -> Path:
    override = os.environ.get("QUICKFILE_SEMANTIC_HOME", "").strip()
    if override:
        return Path(override).expanduser()
    data_home = os.environ.get("XDG_DATA_HOME", "").strip()
    base = Path(data_home).expanduser() if data_home else Path.home() / ".local" / "share"
    return base / "omarchy" / "quickfile" / "semantic"


def managed_semantic_root() -> Path | None:
    """Resolve only a narrow directory that setup/removal may mutate."""
    root = Path(os.path.abspath(str(semantic_root().expanduser())))
    forbidden = {
        Path(os.path.abspath(os.sep)),
        Path(os.path.abspath(str(Path.home()))),
        Path(os.path.abspath(str(Path(__file__).resolve().parents[1]))),
    }
    if root in forbidden or root.name != "semantic":
        return None
    return root


def marker_path() -> Path:
    return semantic_root() / "install.json"


def emit(payload: dict[str, Any]) -> None:
    encoded = json.dumps(payload, ensure_ascii=True, separators=(",", ":"))
    if len(encoded.encode("utf-8")) > MESSAGE_LIMIT:
        encoded = json.dumps({
            "event": "error", "code": "semantic-message-too-large",
            "message": "Smart-search helper produced too much data",
        }, separators=(",", ":"))
    with PROTOCOL_LOCK:
        PROTOCOL_STREAM.write(encoded + "\n")
        PROTOCOL_STREAM.flush()


def safe_install_path(raw: Any) -> Path | None:
    if not isinstance(raw, str) or not raw:
        return None
    # Validate the stored pathname itself, not its final symlink target:
    # venv/bin/python normally points at /usr/bin/python, but the entry that
    # QuickFile executes still lives inside its private install directory.
    root = Path(os.path.abspath(str(semantic_root().expanduser())))
    candidate = Path(os.path.abspath(str(Path(raw).expanduser())))
    try:
        candidate.relative_to(root)
    except ValueError:
        return None
    return candidate


def load_marker() -> dict[str, Any] | None:
    path = marker_path()
    try:
        with path.open("r", encoding="utf-8") as stream:
            raw = stream.read(SMART_PLAN_LIMIT + 1)
        if len(raw.encode("utf-8")) > SMART_PLAN_LIMIT:
            return None
        parsed = json.loads(raw)
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if not isinstance(parsed, dict) or parsed.get("version") != INSTALL_MARKER_VERSION:
        return None
    install = safe_install_path(parsed.get("installPath"))
    model = safe_install_path(parsed.get("modelPath"))
    python = safe_install_path(parsed.get("pythonPath"))
    if install is None or model is None or python is None:
        return None
    required = (
        python,
        model / "multilingual" / "rl_agent_config.json",
        model / "multilingual" / "model.safetensors",
    )
    if not all(path.is_file() for path in required):
        return None
    normalized = dict(parsed)
    normalized.update({
        "installPath": str(install), "modelPath": str(model), "pythonPath": str(python),
    })
    return normalized


def status_payload() -> dict[str, Any]:
    marker = load_marker()
    if marker is None:
        return {
            "ok": True, "state": "not-installed", "installed": False,
            "packageVersion": LAYA_VERSION, "model": "laya-multilingual",
            "revision": MODEL_REVISION,
        }
    compatible = (
        marker.get("packageVersion") == LAYA_VERSION
        and marker.get("revision") == MODEL_REVISION
    )
    return {
        "ok": True, "state": "ready" if compatible else "update-required",
        "installed": compatible,
        "packageVersion": marker.get("packageVersion", LAYA_VERSION),
        "model": "laya-multilingual", "revision": marker.get("revision", ""),
        "pythonPath": marker["pythonPath"] if compatible else "",
    }


def bounded_process(argv: list[str], timeout: float) -> tuple[int, str]:
    """Run an installer child with fixed argv and a bounded stderr tail."""
    global ACTIVE_CHILD
    try:
        process = subprocess.Popen(
            argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
            stderr=subprocess.PIPE, start_new_session=True,
        )
    except OSError as exc:
        return 127, str(exc)
    ACTIVE_CHILD = process
    assert process.stderr is not None
    selector = selectors.DefaultSelector()
    selector.register(process.stderr, selectors.EVENT_READ)
    tail = bytearray()
    deadline = time.monotonic() + max(1.0, timeout)
    timed_out = False
    try:
        while selector.get_map():
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                timed_out = True
                stop_child_group(process)
                break
            events = selector.select(0.2)
            for key, _mask in events:
                chunk = os.read(key.fileobj.fileno(), 8192)
                if not chunk:
                    selector.unregister(key.fileobj)
                    continue
                tail.extend(chunk)
                if len(tail) > 8192:
                    del tail[:-8192]
            if process.poll() is not None and not events:
                # Drain EOF on the next selector pass.
                continue
        code = process.wait()
    finally:
        selector.close()
        if process.poll() is None:
            stop_child_group(process)
            process.wait()
        process.stderr.close()
        if ACTIVE_CHILD is process:
            ACTIVE_CHILD = None
    error = tail.decode("utf-8", "replace").strip()
    if timed_out:
        return 127, f"Installer step timed out after {timeout:g}s"
    return code, error


def write_marker(payload: dict[str, Any]) -> None:
    path = marker_path()
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    descriptor, temporary = tempfile.mkstemp(prefix=".install.", dir=path.parent)
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as stream:
            descriptor = -1
            json.dump(payload, stream, ensure_ascii=True, separators=(",", ":"))
            stream.write("\n")
            stream.flush()
            os.fsync(stream.fileno())
        os.replace(temporary, path)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary)
        except FileNotFoundError:
            pass


def dependency_commands(python: Path) -> list[list[str]]:
    """Fixed pip steps: CPU-only torch first, so Laya's `torch>=2` is already met."""
    pip = [
        str(python), "-m", "pip", "install", "--disable-pip-version-check",
        "--no-input", "--no-cache-dir",
    ]
    return [
        pip + ["--index-url", TORCH_INDEX_URL, "torch"],
        pip + [f"laya=={LAYA_VERSION}"],
    ]


def install_command() -> int:
    existing = load_marker()
    if (existing is not None and existing.get("packageVersion") == LAYA_VERSION
            and existing.get("revision") == MODEL_REVISION):
        emit({"event": "result", **status_payload(), "changed": False})
        return 0

    root = managed_semantic_root()
    if root is None:
        emit({
            "event": "error", "ok": False, "state": "failed",
            "code": "semantic-install-unsafe",
            "message": "Refusing to install into an unsafe smart-search data path",
        })
        return 1
    root.mkdir(parents=True, exist_ok=True, mode=0o700)
    install_id = uuid.uuid4().hex
    staging = root / (".staging-" + install_id)
    destination = root / f"laya-{LAYA_VERSION}-{MODEL_REVISION[:12]}-{install_id[:12]}"
    published = False
    try:
        staging.mkdir(mode=0o700)
        venv = staging / "venv"
        emit({"event": "progress", "phase": "environment", "progress": 0.05})
        code, error = bounded_process(
            [sys.executable, "-m", "venv", str(venv)], timeout=180,
        )
        if code != 0:
            raise RuntimeError(error or "Python could not create the isolated environment")
        python = venv / "bin" / "python"

        runtime, package = dependency_commands(python)
        emit({"event": "progress", "phase": "runtime", "progress": 0.15})
        code, error = bounded_process(runtime, timeout=INSTALL_TIMEOUT)
        if code != 0:
            raise RuntimeError(error or "Could not install the PyTorch CPU runtime")

        emit({"event": "progress", "phase": "dependencies", "progress": 0.45})
        code, error = bounded_process(package, timeout=INSTALL_TIMEOUT)
        if code != 0:
            raise RuntimeError(error or "Could not install Laya dependencies")

        model = staging / "model"
        emit({"event": "progress", "phase": "model", "progress": 0.65})
        code, error = bounded_process([
            str(python), str(Path(__file__).resolve()), "_download",
            "--destination", str(model),
        ], timeout=INSTALL_TIMEOUT)
        if code != 0:
            raise RuntimeError(error or "Could not download the multilingual model")

        emit({"event": "progress", "phase": "verify", "progress": 0.95})
        required = (
            model / "multilingual" / "rl_agent_config.json",
            model / "multilingual" / "model.safetensors",
            python,
        )
        if not all(path.is_file() for path in required):
            raise RuntimeError("The downloaded smart-search model is incomplete")
        os.replace(staging, destination)
        marker = {
            "version": INSTALL_MARKER_VERSION,
            "packageVersion": LAYA_VERSION,
            "revision": MODEL_REVISION,
            "installPath": str(destination),
            "modelPath": str(destination / "model"),
            "pythonPath": str(destination / "venv" / "bin" / "python"),
        }
        write_marker(marker)
        published = True
        emit({"event": "result", **status_payload(), "changed": True})
        return 0
    except (OSError, RuntimeError) as exc:
        emit({
            "event": "error", "ok": False, "state": "failed",
            "code": "semantic-install-failed", "message": str(exc)[:2000],
        })
        return 1
    finally:
        if staging.exists():
            shutil.rmtree(staging, ignore_errors=True)
        if destination.exists() and not published:
            shutil.rmtree(destination, ignore_errors=True)


def download_command(destination: str) -> int:
    target = Path(destination).resolve()
    target.mkdir(parents=True, exist_ok=True, mode=0o700)
    cache = target.parent / ".huggingface-cache"
    os.environ["HF_HOME"] = str(cache)
    os.environ["HF_HUB_CACHE"] = str(cache / "hub")
    os.environ["HF_XET_CACHE"] = str(cache / "xet")
    os.environ["HF_HUB_DISABLE_TELEMETRY"] = "1"
    from huggingface_hub import snapshot_download

    try:
        snapshot_download(
            repo_id=MODEL_REPO,
            revision=MODEL_REVISION,
            allow_patterns=[f"{MODEL_SUBFOLDER}/*"],
            local_dir=str(target),
            cache_dir=str(cache / "hub"),
        )
    finally:
        shutil.rmtree(cache, ignore_errors=True)
        shutil.rmtree(target / ".cache", ignore_errors=True)
    return 0


def remove_command() -> int:
    root = managed_semantic_root()
    if root is None:
        emit({
            "event": "error", "ok": False, "state": "failed",
            "code": "semantic-remove-unsafe",
            "message": "Refusing to remove an unsafe smart-search data path",
        })
        return 1
    if not root.exists():
        emit({"event": "result", "ok": True, "state": "not-installed", "changed": False})
        return 0
    executable = shutil.which("gio")
    if not executable:
        emit({
            "event": "error", "ok": False, "state": "failed",
            "code": "semantic-remove-unavailable",
            "message": "gio is required to move smart-search data to Trash",
        })
        return 1
    code, error = bounded_process([
        executable, "trash", str(root),
    ], timeout=120)
    if code != 0:
        emit({
            "event": "error", "ok": False, "state": "failed",
            "code": "semantic-remove-failed", "message": error or "Could not remove smart search",
        })
        return 1
    emit({"event": "result", "ok": True, "state": "not-installed", "changed": True})
    return 0


def serve_command() -> int:
    marker = load_marker()
    if marker is None:
        emit({
            "event": "error", "ok": False, "code": "semantic-not-installed",
            "message": "Smart search is not installed",
        })
        return 2
    if (marker.get("packageVersion") != LAYA_VERSION
            or marker.get("revision") != MODEL_REVISION):
        emit({
            "event": "error", "ok": False, "code": "semantic-update-required",
            "message": "Smart Search must be updated before it can run",
        })
        return 2

    os.environ["HF_HUB_OFFLINE"] = "1"
    os.environ["TRANSFORMERS_OFFLINE"] = "1"
    os.environ["HF_HUB_DISABLE_TELEMETRY"] = "1"
    try:
        with contextlib.redirect_stdout(sys.stderr):
            import laya
            if getattr(laya, "__version__", "") != LAYA_VERSION:
                raise RuntimeError("The installed Laya package version does not match QuickFile")
            with contextlib.suppress(Exception):
                import torch
                torch.set_num_threads(min(INFERENCE_THREADS, os.cpu_count() or 1))
            agent = laya.load(
                marker["modelPath"], device=INFERENCE_DEVICE, subfolder=MODEL_SUBFOLDER,
            )
    except Exception as exc:  # Optional third-party runtime: report, never crash the shell.
        emit({
            "event": "error", "ok": False, "code": "semantic-load-failed",
            "message": str(exc)[:2000],
        })
        return 3

    device = str(getattr(agent, "device", "unknown"))
    emit({
        "event": "ready", "ok": True, "model": "laya-multilingual",
        "packageVersion": LAYA_VERSION, "revision": MODEL_REVISION, "device": device,
    })

    condition = threading.Condition()
    state: dict[str, Any] = {"latest": None, "closed": False}

    def reader() -> None:
        while True:
            raw = sys.stdin.readline(MESSAGE_LIMIT + 1)
            if raw == "":
                break
            oversized = len(raw.encode("utf-8", "replace")) > MESSAGE_LIMIT
            if oversized:
                # Discard the rest of an overlong record in bounded chunks so
                # a local caller cannot make the sidecar retain an unbounded line.
                while raw and not raw.endswith("\n"):
                    raw = sys.stdin.readline(MESSAGE_LIMIT + 1)
                emit({"event": "error", "code": "semantic-request-too-large",
                      "message": "Smart-search request is too large"})
                continue
            try:
                message = json.loads(raw)
            except json.JSONDecodeError:
                emit({"event": "error", "code": "semantic-request-invalid",
                      "message": "Smart-search request is not valid JSON"})
                continue
            if not isinstance(message, dict) or message.get("op") != "analyze":
                emit({"event": "error", "code": "semantic-request-invalid",
                      "message": "Unsupported smart-search request"})
                continue
            request_id = message.get("id")
            query = message.get("query")
            if (not isinstance(request_id, int) or isinstance(request_id, bool) or request_id < 0
                    or not isinstance(query, str) or not query.strip()
                    or len(query) > SMART_QUERY_LIMIT):
                emit({"event": "error", "id": request_id,
                      "code": "semantic-request-invalid",
                      "message": "Smart-search query is invalid"})
                continue
            with condition:
                state["latest"] = {"id": request_id, "query": query}
                condition.notify()
        with condition:
            state["closed"] = True
            condition.notify()

    threading.Thread(target=reader, name="quickfile-semantic-input", daemon=True).start()
    while True:
        with condition:
            while state["latest"] is None and not state["closed"]:
                condition.wait()
            if state["latest"] is None and state["closed"]:
                return 0
            request = state["latest"]
            state["latest"] = None
        started = time.monotonic()
        try:
            with contextlib.redirect_stdout(sys.stderr):
                result = agent.predict({"query": request["query"]}, questions())
            plan = merge_laya_answers(
                fallback_plan(request["query"], request["id"]), result.get("answers", {}),
            )
            latency_ms = round((time.monotonic() - started) * 1000)
            plan.update({
                "model": "laya-multilingual", "device": device, "latencyMs": latency_ms,
            })
            emit({
                "event": "analysis", "ok": True, "id": request["id"], "plan": plan,
                "model": "laya-multilingual", "device": device,
                "latencyMs": latency_ms,
            })
        except Exception as exc:  # Keep a failed optional inference isolated.
            emit({
                "event": "error", "ok": False, "id": request["id"],
                "code": "semantic-inference-failed", "message": str(exc)[:2000],
            })


def parser() -> argparse.ArgumentParser:
    root = argparse.ArgumentParser(description=__doc__)
    subcommands = root.add_subparsers(dest="command", required=True)
    subcommands.add_parser("status")
    subcommands.add_parser("install")
    subcommands.add_parser("serve")
    subcommands.add_parser("remove")
    download = subcommands.add_parser("_download")
    download.add_argument("--destination", required=True)
    return root


def main() -> int:
    signal.signal(signal.SIGTERM, handle_termination)
    signal.signal(signal.SIGINT, handle_termination)
    args = parser().parse_args()
    if args.command == "status":
        emit(status_payload())
        return 0
    if args.command == "install":
        return install_command()
    if args.command == "serve":
        return serve_command()
    if args.command == "remove":
        return remove_command()
    if args.command == "_download":
        return download_command(args.destination)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
